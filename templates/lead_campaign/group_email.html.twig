{% extends 'base.html.twig' %}
{% block title %}Email groupé{% endblock %}
{% block page_title %}📧 Email groupé{% endblock %}

{% block body %}
<div class="welcome">
    <form method="post">
        <div class="form-group">
            <label class="form-label">Objet</label>
            <input type="text" name="subject" required
                value="Nos services de ménage Airbnb"
                class="form-control">
        </div>
        <div class="form-group">
            <label class="form-label">Message</label>
            <textarea name="body" rows="8" required
                class="form-control">Bonjour,

Nous sommes DP Services, spécialistes du ménage Airbnb.

Nous proposons des prestations professionnelles pour les conciergeries et gestionnaires.

Seriez-vous intéressé(e) par un devis gratuit ?

Cordialement,
L'équipe DP Services</textarea>
        </div>

        <div class="form-group">
            <label class="form-label">
                Sélectionner les prospects
                <span class="text-secondary fw-normal">(uniquement ceux avec un email)</span>
            </label>
            <div class="checkbox-list">
                {% for lead in leads %}
                    {% if lead.email %}
                    <label class="checkbox-list__item">
                        <input type="checkbox" name="lead_ids[]" value="{{ lead.id }}" checked>
                        <span>{{ lead.companyName }}</span>
                        <span class="checkbox-list__meta">— {{ lead.city }} — {{ lead.email }}</span>
                    </label>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <button type="submit" name="preview" value="1" class="btn btn--primary btn--lg">
            👁️ Aperçu avant envoi
        </button>
        <a href="{{ path('app_leads') }}" class="text-secondary text-secondary--spaced">Annuler</a>
    </form>
</div>
{% endblock %}