{% extends 'base.html.twig' %}
{% block title %}Confirmer envoi groupé{% endblock %}
{% block page_title %}Confirmer l'envoi groupé{% endblock %}

{% block body %}
<div class="welcome">
    <div style="background:#fef3c7; border:1px solid #fcd34d; padding:1rem; border-radius:6px; margin-bottom:1.5rem;">
        ⚠️ Vous allez envoyer un email à <strong>{{ leads|length }} prospect(s)</strong>. Cette action est irréversible.
    </div>

    <div style="background:#f8fafc; padding:1rem; border-radius:6px; margin-bottom:1rem;">
        <p><strong>Objet :</strong> {{ subject }}</p>
        <hr style="margin:0.75rem 0; border-color:#e2e8f0;">
        <p style="white-space:pre-line; font-size:0.875rem;">{{ body }}</p>
    </div>

    <div style="margin-bottom:1.5rem;">
        <strong>Destinataires ({{ leads|length }}) :</strong>
        <ul style="margin-top:0.5rem; padding-left:1.5rem;">
            {% for lead in leads %}
                <li style="font-size:0.875rem; color:#475569;">{{ lead.companyName }} — {{ lead.email }}</li>
            {% endfor %}
        </ul>
    </div>

    <form method="post">
        <input type="hidden" name="subject" value="{{ subject }}">
        <input type="hidden" name="body" value="{{ body }}">
        <input type="hidden" name="confirmed" value="1">
        {% for id in leadIds %}
            <input type="hidden" name="lead_ids[]" value="{{ id }}">
        {% endfor %}
        <button type="submit" style="padding:0.75rem 2rem; background:#059669; color:white; border:none; border-radius:4px; cursor:pointer;">
            ✅ Confirmer l'envoi groupé
        </button>
        <a href="{{ path('app_lead_group_email') }}" style="margin-left:1rem; color:#64748b;">← Modifier</a>
    </form>
</div>
{% endblock %}