{% extends 'base.html.twig' %}
{% block title %}Confirmer envoi groupé{% endblock %}
{% block page_title %}Confirmer l'envoi groupé{% endblock %}

{% block body %}
<div class="welcome">
    <div class="alert alert--warning">
        ⚠️ Vous allez envoyer un email à <strong>{{ leads|length }} prospect(s)</strong>. Cette action est irréversible.
    </div>

    <div class="preview-box preview-box--mb-sm">
        <p><strong>Objet :</strong> {{ subject }}</p>
        <hr>
        <p class="preview-box__body preview-box__body--sm">{{ body }}</p>
    </div>

    <div class="mb-lg">
        <strong>Destinataires ({{ leads|length }}) :</strong>
        <ul class="recipient-list">
            {% for lead in leads %}
                <li class="recipient-list__item">{{ lead.companyName }} — {{ lead.email }}</li>
            {% endfor %}
        </ul>
    </div>

    <form method="post">
        <input type="hidden" name="subject" value="{{ subject }}">
        <input type="hidden" name="body" value="{{ body }}">
        <input type="hidden" name="confirmed" value="1">
        {% for id in leadIds %}
            <input type="hidden" name="lead_ids[]" value="{{ id }}">
        {% endfor %}
        <button type="submit" class="btn btn--success btn--lg">
            ✅ Confirmer l'envoi groupé
        </button>
        <a href="{{ path('app_lead_group_email') }}" class="text-secondary text-secondary--spaced">← Modifier</a>
    </form>
</div>
{% endblock %}