{% extends 'base.html.twig' %}
{% block title %}Envoyer SMS{% endblock %}
{% block page_title %}📱 Envoyer un SMS à {{ lead.companyName }}{% endblock %}

{% block body %}
<div class="welcome">
    <p style="color:#64748b; margin-bottom:1.5rem;">
        Destinataire : <strong>{{ lead.phone ?? 'Aucun téléphone renseigné' }}</strong>
    </p>

    {% if not lead.phone %}
        <div style="background:#fee2e2; color:#dc2626; padding:1rem; border-radius:6px;">
            ❌ Ce prospect n'a pas de téléphone. <a href="{{ path('app_lead_edit', {id: lead.id}) }}">Ajouter un téléphone</a>
        </div>
    {% else %}
        <form method="post">
            <div style="margin-bottom:1rem;">
                <label style="display:block; margin-bottom:0.5rem; font-weight:500;">Message (160 caractères max)</label>
                <textarea name="message" rows="4" maxlength="160" required
                    style="width:100%; padding:0.625rem; border:1px solid #ddd; border-radius:6px;"
                    oninput="document.getElementById('count').textContent = this.value.length">Bonjour, DP Services propose des prestations de ménage Airbnb à {{ lead.city }}. Intéressé(e) ? Répondez OUI.</textarea>
                <div style="text-align:right; font-size:0.8rem; color:#64748b;"><span id="count">0</span>/160</div>
            </div>
            <button type="submit" name="preview" value="1"
                style="padding:0.75rem 2rem; background:#2563eb; color:white; border:none; border-radius:4px; cursor:pointer;">
                👁️ Aperçu avant envoi
            </button>
            <a href="{{ path('app_lead_show', {id: lead.id}) }}" style="margin-left:1rem; color:#64748b;">Annuler</a>
        </form>
    {% endif %}
</div>
{% endblock %}