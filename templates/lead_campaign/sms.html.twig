{% extends 'base.html.twig' %}
{% block title %}Envoyer SMS{% endblock %}
{% block page_title %}📱 Envoyer un SMS à {{ lead.companyName }}{% endblock %}

{% block body %}
<div class="welcome">
    <p class="text-secondary mb-lg">
        Destinataire : <strong>{{ lead.phone ?? 'Aucun téléphone renseigné' }}</strong>
    </p>

    {% if not lead.phone %}
        <div class="alert alert--danger">
            ❌ Ce prospect n'a pas de téléphone. <a href="{{ path('app_lead_edit', {id: lead.id}) }}">Ajouter un téléphone</a>
        </div>
    {% else %}

        {% if aiMessage is defined %}
        <div class="alert alert--success alert--mb-sm">
            ✅ SMS généré par l'IA — relisez et modifiez si besoin avant d'envoyer.
        </div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                <label class="form-label">Message (160 caractères max)</label>
                <textarea name="message" rows="4" maxlength="160" required
                    class="form-control"
                    oninput="document.getElementById('count').textContent = this.value.length">{{ aiMessage is defined ? aiMessage : 'Bonjour, DP Services propose des prestations de ménage Airbnb à ' ~ lead.city ~ '. Intéressé(e) ? Répondez OUI.' }}</textarea>
                <div class="char-counter"><span id="count">0</span>/160</div>
            </div>

            <div class="form-actions">
                <button type="submit" name="preview" value="1" class="btn btn--primary btn--lg">
                    👁️ Aperçu avant envoi
                </button>
                <button type="submit" name="generate_ai" value="1" class="btn btn--accent btn--lg">
                    🤖 Générer avec l'IA
                </button>
                <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="text-secondary">Annuler</a>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}