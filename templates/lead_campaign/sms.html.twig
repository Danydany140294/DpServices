{% extends 'base.html.twig' %}
{% block title %}Envoyer SMS{% endblock %}
{% block page_title %}📱 Envoyer un SMS à {{ lead.companyName }}{% endblock %}

{% block body %}
<div class="welcome">
    <p style="color:#64748b; margin-bottom:1.5rem;">
        Destinataire : <strong>{{ lead.phone ?? 'Aucun téléphone renseigné' }}</strong>
    </p>

    {% if not lead.phone %}
        <div style="background:#fee2e2; color:#dc2626; padding:1rem; border-radius:6px;">
            ❌ Ce prospect n'a pas de téléphone. <a href="{{ path('app_lead_edit', {id: lead.id}) }}">Ajouter un téléphone</a>
        </div>
    {% else %}

        {% if aiMessage is defined %}
        <div style="background:#d1fae5; border:1px solid #6ee7b7; padding:1rem; border-radius:6px; margin-bottom:1rem;">
            ✅ SMS généré par l'IA — relisez et modifiez si besoin avant d'envoyer.
        </div>
        {% endif %}

        <form method="post">
            <div style="margin-bottom:1rem;">
                <label style="display:block; margin-bottom:0.5rem; font-weight:500;">Message (160 caractères max)</label>
                <textarea name="message" rows="4" maxlength="160" required
                    style="width:100%; padding:0.625rem; border:1px solid #ddd; border-radius:6px;"
                    oninput="document.getElementById('count').textContent = this.value.length">{{ aiMessage is defined ? aiMessage : 'Bonjour, DP Services propose des prestations de ménage Airbnb à ' ~ lead.city ~ '. Intéressé(e) ? Répondez OUI.' }}</textarea>
                <div style="text-align:right; font-size:0.8rem; color:#64748b;"><span id="count">0</span>/160</div>
            </div>

            <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:center;">
                <button type="submit" name="preview" value="1"
                    style="padding:0.75rem 2rem; background:#2563eb; color:white; border:none; border-radius:4px; cursor:pointer;">
                    👁️ Aperçu avant envoi
                </button>
                <button type="submit" name="generate_ai" value="1"
                    style="padding:0.75rem 2rem; background:#7c3aed; color:white; border:none; border-radius:4px; cursor:pointer;">
                    🤖 Générer avec l'IA
                </button>
                <a href="{{ path('app_lead_show', {id: lead.id}) }}" style="color:#64748b;">Annuler</a>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
