{% extends 'base.html.twig' %}
{% block title %}Confirmer l'envoi{% endblock %}
{% block page_title %}Confirmer l'envoi email{% endblock %}

{% block body %}
<div class="welcome">
    <div class="alert alert--warning">
        ⚠️ Vous allez envoyer un email à <strong>{{ lead.companyName }}</strong> ({{ lead.email }})
    </div>

    <div class="preview-box">
        <p><strong>Objet :</strong> {{ subject }}</p>
        <hr>
        <p class="preview-box__body">{{ body }}</p>
    </div>

    <form method="post">
        <input type="hidden" name="subject" value="{{ subject }}">
        <input type="hidden" name="body" value="{{ body }}">
        <input type="hidden" name="confirmed" value="1">
        <button type="submit" class="btn btn--success btn--lg">
            ✅ Confirmer l'envoi
        </button>
        <a href="{{ path('app_lead_email', {id: lead.id}) }}" class="text-secondary text-secondary--spaced">← Modifier</a>
    </form>
</div>
{% endblock %}