{% extends 'base.html.twig' %}
{% block title %}Confirmer SMS{% endblock %}
{% block page_title %}Confirmer l'envoi SMS{% endblock %}

{% block body %}
<div class="welcome">
    <div class="alert alert--warning">
        ⚠️ Vous allez envoyer un SMS à <strong>{{ lead.companyName }}</strong> ({{ lead.phone }})
    </div>

    <div class="preview-box">
        <p class="preview-box__body">{{ message }}</p>
    </div>

    <form method="post">
        <input type="hidden" name="message" value="{{ message }}">
        <input type="hidden" name="confirmed" value="1">
        <button type="submit" class="btn btn--success btn--lg">
            ✅ Confirmer l'envoi
        </button>
        <a href="{{ path('app_lead_sms', {id: lead.id}) }}" class="text-secondary text-secondary--spaced">← Modifier</a>
    </form>
</div>
{% endblock %}