{% extends 'base.html.twig' %}

{% block title %}Calendrier — DP Services{% endblock %}
{% block page_title %}Calendrier{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('calendar') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('calendar') }}
    <script>
        window.calendarFilters = {
            cleaners: {{ cleaners|map(c => {id: c.id, name: c.firstname ~ ' ' ~ c.lastname})|json_encode|raw }},
            owners: {{ owners|map(o => {id: o.id, name: o.firstname ~ ' ' ~ o.lastname})|json_encode|raw }}
        };
    </script>
{% endblock %}

{% block body %}

    {% if is_granted('ROLE_ADMIN') %}
    <div class="filters">
        <label>Filtrer par FdM :
            <select id="filter-cleaner">
                <option value="">Toutes</option>
            </select>
        </label>
        <label>Filtrer par propriétaire :
            <select id="filter-owner">
                <option value="">Tous</option>
            </select>
        </label>
        <button onclick="applyFilters()">Filtrer</button>
        <button onclick="resetFilters()" class="filters__reset">Réinitialiser</button>
    </div>
    {% endif %}

    <div id="calendar"></div>

{% endblock %}
