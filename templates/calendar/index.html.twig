{% extends 'base.html.twig' %}

{% block title %}Calendrier — DP Services{% endblock %}
{% block page_title %}Calendrier{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('calendar') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('calendar') }}
    <script>
        window.calendarFilters = {
            cleaners: {{ cleaners|map(c => {id: c.id, name: c.firstname ~ ' ' ~ c.lastname})|json_encode|raw }},
            owners: {{ owners|map(o => {id: o.id, name: o.firstname ~ ' ' ~ o.lastname})|json_encode|raw }}
        };
    </script>
{% endblock %}

{% block body %}

    {% if is_granted('ROLE_ADMIN') %}
    <div class="filters">
        <label>Filtrer par FdM :
            <select id="filter-cleaner">
                <option value="">Toutes</option>
            </select>
        </label>
        <label>Filtrer par propriétaire :
            <select id="filter-owner">
                <option value="">Tous</option>
            </select>
        </label>
        <button onclick="applyFilters()">Filtrer</button>
        <button onclick="resetFilters()" class="filters__reset">Réinitialiser</button>
    </div>
    {% endif %}

    <div id="calendar"></div>


    <div id="mission-modal" class="mission-modal-overlay" style="display:none;">
        <div class="mission-modal">
            <button type="button" class="mission-modal-close" onclick="closeMissionModal()">&times;</button>
            <h2 id="mission-modal-property"></h2>
            <div class="mission-modal-row"><strong>Prestation :</strong> <span id="mission-modal-service"></span></div>
            <div class="mission-modal-row"><strong>Date :</strong> <span id="mission-modal-date"></span></div>
            <div class="mission-modal-row"><strong>Heure :</strong> <span id="mission-modal-time"></span></div>
            <div class="mission-modal-row"><strong>Statut :</strong> <span id="mission-modal-status"></span></div>
            <div class="mission-modal-row"><strong>FdM :</strong> <span id="mission-modal-cleaner"></span></div>
            <div class="mission-modal-row" id="mission-modal-comment-row" style="display:none;">
                <strong>Commentaire :</strong> <span id="mission-modal-comment"></span>
            </div>
        </div>
    </div>

{% endblock %}
