{% extends 'base.html.twig' %}

{% block title %}Recherche prospects — DP Services{% endblock %}
{% block page_title %}Recherche de prospects{% endblock %}

{% block body %}

    <div class="filters">
        <form method="get" id="search-form" class="filters__form">

            <div class="filters__group">
                <label class="filters__label">Type de recherche</label>
                <select name="query" class="filters__input--lg">
                    <optgroup label="🏠 Immobilier">
                        <option value="conciergerie airbnb" {{ query == 'conciergerie airbnb' ? 'selected' : '' }}>🏠 Conciergerie Airbnb</option>
                        <option value="gestion locative" {{ query == 'gestion locative' ? 'selected' : '' }}>🏢 Gestion locative</option>
                        <option value="agence immobilière" {{ query == 'agence immobilière' ? 'selected' : '' }}>🏛️ Agence immobilière</option>
                        <option value="location saisonnière" {{ query == 'location saisonnière' ? 'selected' : '' }}>🌴 Location saisonnière</option>
                        <option value="hôtellerie" {{ query == 'hôtellerie' ? 'selected' : '' }}>🏨 Hôtellerie</option>
                        <option value="services immobiliers" {{ query == 'services immobiliers' ? 'selected' : '' }}>🔑 Services immobiliers</option>
                    </optgroup>
                    <optgroup label="🧹 Ménage">
                        <option value="ménage professionnel" {{ query == 'ménage professionnel' ? 'selected' : '' }}>🏢 Ménage professionnel</option>
                        <option value="ménage particulier" {{ query == 'ménage particulier' ? 'selected' : '' }}>🏠 Ménage particulier</option>
                    </optgroup>
                </select>
            </div>

            <div class="filters__group">
                <label class="filters__label">Ville</label>
                <input type="text" name="city" value="{{ city }}" placeholder="Ex: Montpellier" class="filters__input--md">
            </div>

            {# <div>
                <label style="display:block; font-size:0.875rem; color:#64748b; margin-bottom:0.25rem;">Rayon</label>
                <select name="radius" style="padding:0.5rem; border:1px solid #ddd; border-radius:4px;">
                    <option value="5" {{ radius == '5' ? 'selected' : '' }}>5 km</option>
                    <option value="10" {{ radius == '10' ? 'selected' : '' }}>10 km</option>
                    <option value="20" {{ radius == '20' ? 'selected' : '' }}>20 km</option>
                    <option value="50" {{ radius == '50' ? 'selected' : '' }}>50 km</option>
                </select>
            </div> #}

            <button type="submit">
                🔍 Rechercher
            </button>
            <a href="{{ path('app_lead_search') }}" class="filters__link">
                Réinitialiser
            </a>
            <a href="{{ path('app_leads') }}" class="filters__link">
                ← Retour liste
            </a>

            {# ── Filtres J25 — dans le même form ── #}
            <div class="filters__extra">
                <label class="filters__checkbox-label">
                    <input type="checkbox" name="ignore_known" value="1" {{ ignoreKnown ? 'checked' : '' }} class="filters__checkbox">
                    Ignorer les prospects déjà connus
                </label>
                <label class="filters__checkbox-label">
                    <input type="checkbox" name="ignore_clients" value="1" {{ ignoreClients ? 'checked' : '' }} class="filters__checkbox">
                    Ignorer les clients existants
                </label>
                <label class="filters__checkbox-label">
                    <input type="checkbox" name="ignore_lost" value="1" {{ ignoreLost ? 'checked' : '' }} class="filters__checkbox">
                    Ignorer les prospects perdus
                </label>
            </div>

        </form>
    </div>

    {% if results is defined %}
        {% if results|length == 0 %}
            <div class="search-empty">
                Aucun résultat pour "{{ query }}" à {{ city }}.
            </div>
        {% else %}
            <div class="search-summary">
                <span class="search-summary__count">{{ results|length }} résultat(s) trouvé(s) pour "{{ query }}" à {{ city }}</span>
                {% if skipped > 0 %}
                    <span class="search-summary__skipped">
                        ⚠️ {{ skipped }} déjà connu(s) ignoré(s)
                    </span>
                {% endif %}
            </div>

            <div class="search-results">
                {% for place in results %}
                <div class="result-card">
                    <div>
                        <h3 class="result-card__title">{{ place.name }}</h3>
                        <p class="result-card__address">📍 {{ place.address }}</p>
                        <p class="result-card__source">🔎 Trouvé via : {{ place.keyword }}</p>
                        {% if place.rating %}
                            <p class="result-card__rating">
                                ⭐ {{ place.rating }}/5
                                {% if place.reviews %}({{ place.reviews }} avis){% endif %}
                            </p>
                        {% endif %}
                        {% if place.duplicate %}
                            <span class="result-card__duplicate-badge">
                                ⚠️ Déjà dans la base
                            </span>
                        {% endif %}
                    </div>
                    {% if not place.duplicate %}
                    <form method="post" action="{{ path('app_lead_import') }}">
                        <input type="hidden" name="name" value="{{ place.name }}">
                        <input type="hidden" name="address" value="{{ place.address }}">
                        <input type="hidden" name="rating" value="{{ place.rating }}">
                        <input type="hidden" name="reviews" value="{{ place.reviews }}">
                        <input type="hidden" name="place_id" value="{{ place.place_id }}">
                        <input type="hidden" name="city" value="{{ city }}">
                        <input type="hidden" name="query" value="{{ query }}">
                        <button type="submit" class="btn-action btn-action--import">
                            + Importer
                        </button>
                    </form>
                    {% else %}
                    <span class="result-card__imported-tag">
                        Déjà importé
                    </span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

{% endblock %}