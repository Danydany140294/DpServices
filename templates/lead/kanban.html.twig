{% extends 'base.html.twig' %}

{% block title %}Kanban Prospects — DP Services{% endblock %}
{% block page_title %}📋 Vue Kanban{% endblock %}

{% block body %}

<a href="{{ path('app_leads') }}" class="back-link back-link--pill">← Retour vue tableau</a>

{% set statusConfig = {
    'NEW': '🔵 Nouveau',
    'CONTACTED': '🟡 Contacté',
    'DISCUSSION': '🟠 En discussion',
    'QUOTE_SENT': '🟣 Devis envoyé',
    'TO_FOLLOW_UP': '⚪ À relancer',
    'CLIENT': '🟢 Client',
    'LOST': '🔴 Perdu'
} %}

<div class="kanban-board">
    {% for status, leads in leadsByStatus %}
        <div class="kanban-column" data-status="{{ status }}">

            <div class="kanban-column__header">
                <span class="kanban-column__label">{{ statusConfig[status] }}</span>
                <span class="kanban-column__count">{{ leads|length }}</span>
            </div>

            <div class="kanban-cards">
                {% for lead in leads %}
                    {% set score = lead.score %}
                    {% set scoreTier = score >= 80 ? 'critical' : (score >= 50 ? 'high' : (score >= 20 ? 'medium' : 'low')) %}
                    <div class="kanban-card" draggable="true" data-id="{{ lead.id }}">
                        <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="kanban-card__link">
                            <div class="kanban-card__title">{{ lead.companyName }}</div>
                            <div class="kanban-card__city">📍 {{ lead.city }}</div>
                            <div class="kanban-card__footer">
                                <span class="kanban-card__category">{{ lead.category ? lead.category.name : '—' }}</span>
                                <span class="kanban-card__score kanban-card__score--{{ scoreTier }}">{{ score }}</span>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    let draggedCard = null;

    document.querySelectorAll('.kanban-card').forEach(card => {
        card.addEventListener('dragstart', function(e) {
            draggedCard = this;
            e.dataTransfer.effectAllowed = 'move';
            this.classList.add('kanban-card--dragging');
        });
        card.addEventListener('dragend', function() {
            this.classList.remove('kanban-card--dragging');
        });
    });

    document.querySelectorAll('.kanban-column').forEach(column => {
        column.addEventListener('dragover', function(e) {
            e.preventDefault();
            this.classList.add('kanban-column--drag-over');
        });
        column.addEventListener('dragleave', function() {
            this.classList.remove('kanban-column--drag-over');
        });
        column.addEventListener('drop', function(e) {
            e.preventDefault();
            this.classList.remove('kanban-column--drag-over');

            if (!draggedCard) return;

            const newStatus = this.dataset.status;
            const leadId = draggedCard.dataset.id;

            this.querySelector('.kanban-cards').appendChild(draggedCard);

            fetch(`/acquisition/leads/${leadId}/kanban-status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });

            draggedCard = null;
        });
    });
});
</script>

{% endblock %}