{% extends 'base.html.twig' %}

{% block title %}Prospects — DP Services{% endblock %}
{% block page_title %}Prospects{% endblock %}

{% block body %}

    {# ── Alertes ── #}
    {% set toFollowUp = leads|filter(l => l.nextFollowUp is not null and l.nextFollowUp <= date()) %}
    {% if toFollowUp|length > 0 %}
        <div class="alert-banner alert-banner--warning">
            🔔 <strong>{{ toFollowUp|length }} prospect(s) à relancer aujourd'hui</strong>
        </div>
    {% endif %}

    {% if noResponse|length > 0 %}
        <div class="alert-banner alert-banner--danger">
            ⏰ <strong>{{ noResponse|length }} prospect(s) sans réponse depuis 7 jours ou plus</strong>
            <span class="alert-banner__note"> — pensez à relancer :</span>
            {% for lead in noResponse|slice(0, 3) %}
                <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="alert-banner__link">{{ lead.companyName }}</a>
            {% endfor %}
            {% if noResponse|length > 3 %}<span class="alert-banner__note"> et {{ noResponse|length - 3 }} autre(s)</span>{% endif %}
        </div>
    {% endif %}

    {# ── Filtres ── #}
    <div class="filters">
        <form method="get" class="filters__form">
            <select name="status">
                <option value="">Tous les statuts</option>
                <option value="NEW" {{ currentStatus == 'NEW' ? 'selected' : '' }}>🔵 Nouveau</option>
                <option value="CONTACTED" {{ currentStatus == 'CONTACTED' ? 'selected' : '' }}>🟡 Contacté</option>
                <option value="DISCUSSION" {{ currentStatus == 'DISCUSSION' ? 'selected' : '' }}>🟠 En discussion</option>
                <option value="QUOTE_SENT" {{ currentStatus == 'QUOTE_SENT' ? 'selected' : '' }}>🟣 Devis envoyé</option>
                <option value="CLIENT" {{ currentStatus == 'CLIENT' ? 'selected' : '' }}>🟢 Client</option>
                <option value="LOST" {{ currentStatus == 'LOST' ? 'selected' : '' }}>🔴 Perdu</option>
                <option value="TO_FOLLOW_UP" {{ currentStatus == 'TO_FOLLOW_UP' ? 'selected' : '' }}>⚪ À relancer</option>
            </select>

            <select name="category">
                <option value="">Toutes les catégories</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {{ currentCategory == cat.id ~ '' ? 'selected' : '' }}>{{ cat.name }}</option>
                {% endfor %}
            </select>

            <input type="text" name="city" value="{{ currentCity }}" placeholder="Ville...">

            <input type="number" name="score_min" value="{{ currentScoreMin }}" placeholder="Score min..." class="filters__input--narrow">

            <input type="date" name="follow_up" value="{{ currentFollowUp }}">

            <button type="submit">Filtrer</button>
            <a href="{{ path('app_leads') }}" class="filters__reset">Réinitialiser</a>

            {# ── Légende ── #}
            <div class="legend-wrapper">
                <button type="button" onclick="document.getElementById('legend').classList.toggle('hidden')" class="legend-trigger">
                    ? Aide
                </button>
                <div id="legend" class="hidden legend-panel">
                    <h3 class="legend-panel__title legend-panel__title--intro">📊 Comprendre le score</h3>
                    <p class="legend-panel__intro">Plus le score est élevé, plus ce prospect a de chances de devenir client.</p>
                    <div class="legend-panel__row">🔴 <strong>80-100</strong> — Priorité absolue → Appeler aujourd'hui</div>
                    <div class="legend-panel__row">🟠 <strong>50-79</strong> — Important → Appeler cette semaine</div>
                    <div class="legend-panel__row">🟡 <strong>20-49</strong> — Secondaire → Email suffira</div>
                    <div class="legend-panel__row legend-panel__row--gap">⚪ <strong>0-19</strong> — Faible potentiel</div>
                    <h3 class="legend-panel__title">📋 Statuts</h3>
                    <div class="legend-panel__list">
                        🔵 Nouveau · 🟡 Contacté · 🟠 En discussion<br>
                        🟣 Devis envoyé · 🟢 Client · 🔴 Perdu · ⚪ À relancer
                    </div>
                    <h3 class="legend-panel__title u-mt-1">🎯 Barème score</h3>
                    <div class="legend-panel__list">
                        Conciergerie Airbnb +50 · Gestion locative +30<br>
                        Agence immo +20 · >100 avis +20 · Site web +10<br>
                        Note >4.5 +10 · 50-100 avis +10 · Ville prioritaire +10
                    </div>
                    <button type="button" onclick="document.getElementById('legend').classList.toggle('hidden')" class="legend-panel__close">
                        ✖ Fermer
                    </button>
                </div>
            </div>
        </form>
    </div>

    {# ── Boutons actions ── #}
    <div class="action-bar">
        <a href="{{ path('app_lead_new') }}" class="btn-quick btn-quick--blue">+ Nouveau prospect</a>
        <a href="{{ path('app_lead_search') }}" class="btn-quick btn-quick--green">🔍 Rechercher</a>
        <a href="{{ path('app_lead_group_email') }}" class="btn-quick btn-quick--purple">📧 Email groupé</a>
        <a href="{{ path('app_lead_import_file') }}" class="btn-quick btn-quick--cyan">📂 Importer un fichier</a>
        <a href="{{ path('app_lead_export_excel', {status: currentStatus, city: currentCity, category: currentCategory, score_min: currentScoreMin}) }}" class="btn-quick btn-quick--emerald">📊 Export Excel</a>
        <a href="{{ path('app_leads_kanban') }}" class="btn-quick btn-quick--purple">📋 Vue Kanban</a>
        <form method="post" action="{{ path('app_leads_rescore_all') }}">
            <button type="submit" class="btn-quick btn-quick--amber">
                🔄 Recalculer tous les scores
            </button>
        </form>
    </div>

    {# ── Recherche rapide ── #}
    <div class="u-mb-1">
        <input type="text" id="searchInput" placeholder="🔍 Rechercher par nom ou ville..." class="quick-search">
    </div>

    {# ── Tableau ── #}
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="data-table__th--sortable" onclick="sortTable(0)">Entreprise ↕</th>
                    <th class="data-table__th--sortable" onclick="sortTable(1)">Ville ↕</th>
                    <th class="data-table__th--sortable" onclick="sortTable(2)">Catégorie ↕</th>
                    <th class="data-table__th--sortable" onclick="sortTable(3)">Score ↕</th>
                    <th class="data-table__th--sortable" onclick="sortTable(4)">Statut ↕</th>
                    <th class="data-table__th--sortable" onclick="sortTable(5)">Relance ↕</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for lead in leads %}
                <tr>
                    <td>
                        <div class="data-table__cell-title">{{ lead.companyName }}</div>
                        {% if lead.contactName %}<div class="data-table__cell-subtitle">{{ lead.contactName }}</div>{% endif %}
                    </td>
                    <td class="data-table__text">{{ lead.city }}</td>
                    <td class="data-table__text">{{ lead.category ? lead.category.name : '—' }}</td>

                    {# Colonne Score — avec barre #}
                    <td>
                        {% set score = lead.score %}
                        {% set scoreTier = score >= 80 ? 'critical' : (score >= 50 ? 'high' : (score >= 20 ? 'medium' : 'low')) %}
                        {% if score >= 80 %}
                            <span class="score-badge score-badge--critical">🔴 {{ score }}</span>
                        {% elseif score >= 50 %}
                            <span class="score-badge score-badge--high">🟠 {{ score }}</span>
                        {% elseif score >= 20 %}
                            <span class="score-badge score-badge--medium">🟡 {{ score }}</span>
                        {% else %}
                            <span class="score-badge score-badge--low">⚪ {{ score }}</span>
                        {% endif %}
                        <div class="score-bar">
                            <div class="score-bar__fill score-bar__fill--{{ scoreTier }}" style="width:{{ score }}%;"></div>
                        </div>
                    </td>

                    {# Colonne Statut #}
                    <td>
                        {% if lead.status == 'NEW' %}
                            <span class="status-badge status-badge--new">🔵 Nouveau</span>
                        {% elseif lead.status == 'CONTACTED' %}
                            <span class="status-badge status-badge--contacted">🟡 Contacté</span>
                        {% elseif lead.status == 'DISCUSSION' %}
                            <span class="status-badge status-badge--discussion">🟠 En discussion</span>
                        {% elseif lead.status == 'QUOTE_SENT' %}
                            <span class="status-badge status-badge--quote-sent">🟣 Devis envoyé</span>
                        {% elseif lead.status == 'CLIENT' %}
                            <span class="status-badge status-badge--client">🟢 Client</span>
                        {% elseif lead.status == 'LOST' %}
                            <span class="status-badge status-badge--lost">🔴 Perdu</span>
                        {% elseif lead.status == 'TO_FOLLOW_UP' %}
                            <span class="status-badge status-badge--follow-up">⚪ À relancer</span>
                        {% endif %}
                    </td>

                    {% set overdue = lead.nextFollowUp is not null and lead.nextFollowUp <= date() %}
                    <td class="data-table__text{{ overdue ? ' data-table__text--overdue' : '' }}">
                        {{ lead.nextFollowUp ? lead.nextFollowUp|date('d/m/Y') : '—' }}
                    </td>
                    <td>
                        <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="table-action-link">Voir</a>
                        <a href="{{ path('app_lead_edit', {id: lead.id}) }}" class="table-action-link--warning">Modifier</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="table-wrapper__empty">
                        Aucun prospect. <a href="{{ path('app_lead_search') }}" class="table-action-link">Lancer une recherche</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── Pagination ── #}
    {% if leads.pageCount > 1 %}
    <div class="pagination">
        {% if leads.currentPageNumber > 1 %}
            <a href="{{ path('app_leads', {'page': leads.currentPageNumber - 1, 'status': currentStatus, 'city': currentCity, 'category': currentCategory}) }}" class="pagination__link">← Précédent</a>
        {% endif %}

        {% for i in leads.paginationData.pagesInRange %}
            <a href="{{ path('app_leads', {'page': i, 'status': currentStatus, 'city': currentCity, 'category': currentCategory}) }}"
               class="pagination__page{{ i == leads.currentPageNumber ? ' pagination__page--active' : '' }}">
                {{ i }}
            </a>
        {% endfor %}

        {% if leads.currentPageNumber < leads.pageCount %}
            <a href="{{ path('app_leads', {'page': leads.currentPageNumber + 1, 'status': currentStatus, 'city': currentCity, 'category': currentCategory}) }}" class="pagination__link">Suivant →</a>
        {% endif %}

        <span class="pagination__total">{{ leads.totalItemCount }} prospect(s) au total</span>
    </div>
    {% endif %}

    <script>
        document.getElementById('searchInput').addEventListener('input', function() {
            const search = this.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(search) ? '' : 'none';
            });
        });
    </script>

    <script>
    let sortDir = {};
    function sortTable(col) {
        const table = document.querySelector('tbody');
        const rows = Array.from(table.querySelectorAll('tr'));
        sortDir[col] = !sortDir[col];
        rows.sort((a, b) => {
            const aText = a.cells[col]?.textContent.trim().toLowerCase() || '';
            const bText = b.cells[col]?.textContent.trim().toLowerCase() || '';
            const aNum = parseFloat(aText);
            const bNum = parseFloat(bText);
            if (!isNaN(aNum) && !isNaN(bNum)) {
                return sortDir[col] ? aNum - bNum : bNum - aNum;
            }
            return sortDir[col] ? aText.localeCompare(bText) : bText.localeCompare(aText);
        });
        rows.forEach(row => table.appendChild(row));
    }
    </script>

{% endblock %}