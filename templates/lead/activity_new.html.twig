{% extends 'base.html.twig' %}

{% block title %}Nouvelle action — {{ lead.companyName }}{% endblock %}
{% block page_title %}Nouvelle action — {{ lead.companyName }}{% endblock %}

{% block body %}
    <div>
        <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="back-link">← Retour à la fiche</a>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_row(form.type) }}
            {{ form_row(form.result) }}
            {{ form_row(form.note) }}
            {{ form_row(form.followUpDate) }}

            <button type="submit" class="btn-submit">
                Enregistrer
            </button>
            <a href="{{ path('app_lead_show', {id: lead.id}) }}" class="btn-cancel-link">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}