{% extends 'base.html.twig' %}

{% block title %}Import fichier — DP Services{% endblock %}
{% block page_title %}📂 Importer des prospects depuis un fichier{% endblock %}

{% block body %}
<div class="card import-panel">

    <p class="import-panel__intro">
        Importez une liste de prospects depuis un fichier CSV ou Excel (.xlsx).
    </p>

    <div class="info-box">
        <strong>Colonnes attendues (première ligne) :</strong><br>
        Entreprise, Ville, Email, Téléphone, Catégorie
        <br><br>
        <strong>Exemple :</strong><br>
        Entreprise | Ville | Email | Téléphone | Catégorie<br>
        Conciergerie Test | Montpellier | test@mail.com | 0612345678 | Conciergerie Airbnb
    </div>

    <form method="post" enctype="multipart/form-data">
        <div class="form-field">
            <label class="form-field__label">Fichier (.csv, .xlsx)</label>
            <input type="file" name="file" accept=".csv,.xlsx,.xls" required class="form-field__input">
        </div>

        <button type="submit" class="btn-submit">
            📂 Importer
        </button>
        <a href="{{ path('app_leads') }}" class="btn-cancel-link">Annuler</a>
    </form>

</div>
{% endblock %}