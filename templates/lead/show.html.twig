{% extends 'base.html.twig' %}

{% block title %}{{ lead.companyName }} — DP Services{% endblock %}
{% block page_title %}{{ lead.companyName }}{% endblock %}

{% block body %}

    <div class="lead-detail__grid">

        {# ── Fiche principale ── #}
        <div>
            <div class="card">
                <div class="card-header card-header--align-start">
                    <div>
                        <h2 class="card-title">{{ lead.companyName }}</h2>
                        {% if lead.contactName %}<p class="text-secondary">👤 {{ lead.contactName }}</p>{% endif %}
                    </div>
                    <div class="lead-detail__score">
                        {% set score = lead.score %}
                        {% if score >= 80 %}
                            {% set scoreTier = 'danger' %}{% set scoreIcon = '🔴' %}
                        {% elseif score >= 50 %}
                            {% set scoreTier = 'warning' %}{% set scoreIcon = '🟠' %}
                        {% elseif score >= 20 %}
                            {% set scoreTier = 'caution' %}{% set scoreIcon = '🟡' %}
                        {% else %}
                            {% set scoreTier = 'neutral' %}{% set scoreIcon = '⚪' %}
                        {% endif %}
                        <span class="status-badge status-badge--lg status-badge--{{ scoreTier }}">{{ scoreIcon }} {{ score }}/100</span>
                        <div class="progress-bar">
                            <div class="progress-bar__fill progress-bar__fill--{{ scoreTier }}" style="width:{{ score }}%"></div>
                        </div>
                    </div>
                </div>

                <div class="info-grid">
                    <div>
                        <p class="field-label">Ville</p>
                        <p>📍 {{ lead.city }}</p>
                    </div>
                    <div>
                        <p class="field-label">Catégorie</p>
                        <p>{{ lead.category ? lead.category.name : '—' }}</p>
                    </div>
                    {% if lead.phone %}
                    <div>
                        <p class="field-label">Téléphone</p>
                        <p>📞 {{ lead.phone }}</p>
                    </div>
                    {% endif %}
                    {% if lead.email %}
                    <div>
                        <p class="field-label">Email</p>
                        <p>✉️ {{ lead.email }}</p>
                    </div>
                    {% endif %}
                    {% if lead.website %}
                    <div>
                        <p class="field-label">Site web</p>
                        <p>🌐 <a href="{{ lead.website }}" target="_blank" class="text-link">{{ lead.website }}</a></p>
                    </div>
                    {% endif %}
                    {% if lead.googleRating %}
                    <div>
                        <p class="field-label">Google</p>
                        <p>⭐ {{ lead.googleRating }}/5 ({{ lead.googleReviews }} avis)</p>
                    </div>
                    {% endif %}
                    <div>
                        <p class="field-label">Airbnb</p>
                        <p>{{ lead.hasAirbnb ? '✅ Présent sur Airbnb' : '❌ Pas sur Airbnb' }}</p>
                    </div>
                    <div>
                        <p class="field-label">Créé le</p>
                        <p>{{ lead.createdAt|date('d/m/Y') }}</p>
                    </div>
                </div>

                <div class="card-section--divider">
                    <p class="field-label">Notes</p>
                    <form method="post" action="{{ path('app_lead_notes', {id: lead.id}) }}">
                        <textarea name="notes" rows="4" class="form-textarea">{{ lead.notes }}</textarea>
                        <button type="submit" class="btn btn--primary">
                            💾 Sauvegarder les notes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        {# ── Panneau latéral ── #}
        <div class="lead-detail__sidebar">
            {# Statut #}
            <div class="card">
                <h3 class="card-title card-title--spaced">Statut actuel</h3>
                {% if lead.status == 'NEW' %}<span class="status-badge status-badge--info">🔵 Nouveau</span>
                {% elseif lead.status == 'CONTACTED' %}<span class="status-badge status-badge--caution">🟡 Contacté</span>
                {% elseif lead.status == 'DISCUSSION' %}<span class="status-badge status-badge--warning">🟠 En discussion</span>
                {% elseif lead.status == 'QUOTE_SENT' %}<span class="status-badge status-badge--purple">🟣 Devis envoyé</span>
                {% elseif lead.status == 'CLIENT' %}<span class="status-badge status-badge--success">🟢 Client</span>
                {% elseif lead.status == 'LOST' %}<span class="status-badge status-badge--danger">🔴 Perdu</span>
                {% elseif lead.status == 'TO_FOLLOW_UP' %}<span class="status-badge status-badge--neutral">⚪ À relancer</span>
                {% endif %}

                {% if lead.nextFollowUp %}
                <p class="follow-up-notice{{ lead.nextFollowUp <= date() ? ' follow-up-notice--overdue' : '' }}">
                    🔔 Relance : {{ lead.nextFollowUp|date('d/m/Y') }}
                </p>
                {% endif %}
            </div>

            {# Actions #}
            <div class="card">
                <h3 class="card-title card-title--spaced">Actions</h3>
                <div class="action-list">
                    <a href="{{ path('app_lead_edit', {id: lead.id}) }}" class="btn btn--block btn--primary">✏️ Modifier</a>
                    <a href="{{ path('app_leads') }}" class="btn btn--block btn--secondary">← Retour liste</a>
                    <a href="{{ path('app_lead_email', {id: lead.id}) }}" class="btn btn--block btn--success">📧 Envoyer un email</a>
                    <a href="{{ path('app_lead_sms', {id: lead.id}) }}" class="btn btn--block btn--accent">📱 Envoyer un SMS</a>
                    <a href="{{ path('devis_nouveau', {leadId: lead.id}) }}" class="btn btn--block btn--warning">📄 Nouveau devis</a>
                    <a href="{{ path('devis_liste', {leadId: lead.id}) }}" class="btn btn--block btn--secondary">📋 Voir les devis</a>
                    {% if lead.status != 'CLIENT' %}
                    <form method="post" action="{{ path('app_lead_convert', {id: lead.id}) }}" onsubmit="return confirm('Convertir ce prospect en client ? Un compte ROLE_OWNER sera créé.')">
                        <button type="submit" class="btn btn--block btn--confirm">
                            ✅ Convertir en client
                        </button>
                    </form>
                    {% endif %}
                    <form method="post" action="{{ path('app_lead_summarize', {id: lead.id}) }}">
                        <button type="submit" class="btn btn--block btn--info">
                            🤖 Résumer avec l'IA
                        </button>
                    </form>
                </div>
            </div>
        </div>

        {# ── Timeline des actions ── #}
        <div class="lead-detail__timeline">
            <div class="card">
                <div class="card-header card-header--spaced">
                    <h3 class="card-title">📋 Historique des actions</h3>
                    <a href="{{ path('app_lead_activity_new', {id: lead.id}) }}" class="btn btn--primary">
                        + Nouvelle action
                    </a>
                </div>

                {% set activities = lead.leadActivities|sort((a, b) => b.activityDate <=> a.activityDate) %}

                {% if activities|length == 0 %}
                    <p class="empty-state">Aucune action enregistrée.</p>
                {% else %}
                    <div class="timeline">
                        <div class="timeline__line"></div>

                        {% for activity in activities %}
                            {% if activity.type == 'CALL' %}
                                {% set typeSlug = 'call' %}{% set icon = '📞' %}{% set typeLabel = 'Appel' %}
                            {% elseif activity.type == 'EMAIL' %}
                                {% set typeSlug = 'email' %}{% set icon = '✉️' %}{% set typeLabel = 'Email' %}
                            {% elseif activity.type == 'SMS' %}
                                {% set typeSlug = 'sms' %}{% set icon = '💬' %}{% set typeLabel = 'SMS' %}
                            {% elseif activity.type == 'QUOTE' %}
                                {% set typeSlug = 'quote' %}{% set icon = '📄' %}{% set typeLabel = 'Devis' %}
                            {% elseif activity.type == 'MEETING' %}
                                {% set typeSlug = 'meeting' %}{% set icon = '🤝' %}{% set typeLabel = 'Réunion' %}
                            {% else %}
                                {% set typeSlug = 'other' %}{% set icon = '📌' %}{% set typeLabel = '' %}
                            {% endif %}

                            <div class="timeline__item timeline__item--{{ typeSlug }}">
                                <div class="timeline__dot"></div>

                                <div class="timeline__content">
                                    <div class="timeline__header">
                                        <div>
                                            <span class="timeline__label">{{ icon }} {{ typeLabel }}</span>
                                            {% if activity.result %}
                                                {% if activity.result == 'POSITIVE' %}
                                                    <span class="status-badge status-badge--sm status-badge--success">✅ Positif</span>
                                                {% elseif activity.result == 'NEGATIVE' %}
                                                    <span class="status-badge status-badge--sm status-badge--danger">❌ Négatif</span>
                                                {% elseif activity.result == 'NO_ANSWER' %}
                                                    <span class="status-badge status-badge--sm status-badge--neutral">📵 Sans réponse</span>
                                                {% elseif activity.result == 'CALLBACK' %}
                                                    <span class="status-badge status-badge--sm status-badge--info">🔄 À rappeler</span>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                        <div class="timeline__meta">
                                            <span class="timeline__date">{{ activity.activityDate|date('d/m/Y à H:i') }}</span>
                                            <form method="post" action="{{ path('app_lead_activity_delete', {id: lead.id, activityId: activity.id}) }}"
                                                  onsubmit="return confirm('Supprimer cette action ?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_activity_' ~ activity.id) }}">
                                                <button type="submit" class="icon-btn icon-btn--danger">✖</button>
                                            </form>
                                        </div>
                                    </div>

                                    {% if activity.note %}
                                        <p class="timeline__note">{{ activity.note }}</p>
                                    {% endif %}

                                    {% if activity.followUpDate %}
                                        <p class="timeline__followup">
                                            🔔 Relance prévue : {{ activity.followUpDate|date('d/m/Y') }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

    </div>

{% endblock %}