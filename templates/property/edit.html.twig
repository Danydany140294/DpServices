{% extends 'base.html.twig' %}

{% block title %}Modifier logement — DP Services{% endblock %}
{% block page_title %}Modifier {{ property.name }}{% endblock %}

{% block body %}
    <div class="welcome">
        {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.city) }}
    {{ form_row(form.color) }}
    {{ form_row(form.sector) }}
    {{ form_row(form.owner) }}
    <button type="submit" style="margin-top:1rem; padding:0.75rem 2rem; background:#2563eb; color:white; border:none; border-radius:4px; cursor:pointer;">
        Créer
    </button>
    <a href="{{ path('app_properties') }}" style="margin-left:1rem; color:#64748b;">Annuler</a>
{{ form_end(form) }}
    </div>
{% endblock %}