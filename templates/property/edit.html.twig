{% extends 'base.html.twig' %}

{% block title %}Modifier logement — DP Services{% endblock %}
{% block page_title %}Modifier {{ property.name }}{% endblock %}

{% block body %}
    <div class="welcome">
        {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.city) }}
    {{ form_row(form.color) }}
    {{ form_row(form.sector) }}
    {{ form_row(form.owner) }}
    <button type="submit" class="btn btn--primary btn--lg mt-md">
        Créer
    </button>
    <a href="{{ path('app_properties') }}" class="text-secondary text-secondary--spaced">Annuler</a>
{{ form_end(form) }}
    </div>

    <script>
        document.querySelectorAll('#property_color input[data-color]').forEach(function (input) {
            input.style.setProperty('--swatch-color', input.dataset.color);
        });
    </script>
{% endblock %}
