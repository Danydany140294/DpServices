{% extends 'base.html.twig' %}

{% block title %}Modifier logement — DP Services{% endblock %}
{% block page_title %}Modifier {{ property.name }}{% endblock %}

{% block body %}

    <a href="{{ path('app_properties') }}" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour aux logements</a>

    <div class="form-card">
        <div class="form-card__head">
            <div class="form-card__icon"><i class="fa-solid fa-house-chimney"></i></div>
            <div>
                <h2>Modifier {{ property.name }}</h2>
                <p>Mettez à jour les informations du logement</p>
            </div>
        </div>

        {% if property.photo %}
            <div class="form-card__current-photo">
                <img src="{{ asset('uploads/properties/' ~ property.photo) }}" alt="{{ property.name }}" class="property-thumb property-thumb--lg">
                <span class="text-dim">Photo actuelle — choisissez un nouveau fichier ci-dessous pour la remplacer</span>
            </div>
        {% endif %}

        {{ form_start(form, {'attr': {'class': 'form-card__body'}}) }}
            <div class="form-grid-2">
                {{ form_row(form.name) }}
                {{ form_row(form.city) }}
            </div>
            {{ form_row(form.color) }}
            {{ form_row(form.sector) }}
            {{ form_row(form.owner) }}
            {{ form_row(form.photoFile) }}

            <div class="form-card__actions">
                <button type="submit" class="btn btn--primary btn--lg">
                    <i class="fa-solid fa-check"></i> Sauvegarder
                </button>
                <a href="{{ path('app_properties') }}" class="text-secondary text-secondary--spaced">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>

    <script>
        document.querySelectorAll('#property_color input[data-color]').forEach(function (input) {
            input.style.setProperty('--swatch-color', input.dataset.color);
        });
    </script>
{% endblock %}
