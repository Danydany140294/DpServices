{% extends 'base.html.twig' %}

{% block title %}Logements — DP Services{% endblock %}
{% block page_title %}Gestion des logements{% endblock %}

{% block body %}

    <div style="margin-bottom:1rem;">
        <a href="{{ path('app_property_new') }}" style="padding:0.75rem 1.5rem; background:#2563eb; color:white; border-radius:4px; text-decoration:none;">
            + Nouveau logement
        </a>
    </div>

    <table style="width:100%; background:white; border-radius:8px; border-collapse:collapse;">
        <thead>
            <tr style="background:#f1f5f9;">
                <th style="padding:1rem; text-align:left;">Couleur</th>
                <th style="padding:1rem; text-align:left;">Nom</th>
                <th style="padding:1rem; text-align:left;">Ville</th>
                <th style="padding:1rem; text-align:left;">Propriétaire</th>
                <th style="padding:1rem; text-align:left;">Créé le</th>
                <th style="padding:1rem; text-align:left;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for property in properties %}
            <tr style="border-top:1px solid #e2e8f0;">
                <td style="padding:1rem;">
                    <span style="display:inline-block; width:24px; height:24px; background:{{ property.color }}; border-radius:4px;"></span>
                </td>
                <td style="padding:1rem;">{{ property.name }}</td>
                <td style="padding:1rem;">{{ property.city }}</td>
                <td style="padding:1rem;">{{ property.owner.firstname }} {{ property.owner.lastname }}</td>
                <td style="padding:1rem;">{{ property.createdAt|date('d/m/Y') }}</td>
                <td style="padding:1rem;">
                    <a href="{{ path('app_property_edit', {id: property.id}) }}" style="color:#2563eb; margin-right:1rem;">Modifier</a>
                    <form method="post" action="{{ path('app_property_delete', {id: property.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce logement ?')">
                        <button type="submit" style="color:#ef4444; background:none; border:none; cursor:pointer;">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" style="padding:1rem; text-align:center; color:#94a3b8;">Aucun logement</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}