{% extends 'base.html.twig' %}

{% block title %}Logements — DP Services{% endblock %}
{% block page_title %}Gestion des logements{% endblock %}

{% block body %}

    <div class="mb-md">
        <a href="{{ path('app_property_new') }}" class="btn btn--primary btn--md">
            + Nouveau logement
        </a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Couleur</th>
                <th>Nom</th>
                <th>Ville</th>
                <th>Propriétaire</th>
                <th>Créé le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for property in properties %}
            <tr>
                <td>
                    <span class="color-swatch" style="background:{{ property.color }};"></span>
                </td>
                <td>{{ property.name }}</td>
                <td>{{ property.city }}</td>
                <td>{{ property.owner.firstname }} {{ property.owner.lastname }}</td>
                <td>{{ property.createdAt|date('d/m/Y') }}</td>
                <td>
                    <a href="{{ path('app_property_edit', {id: property.id}) }}" class="text-link mr-md">Modifier</a>
                    <form method="post" action="{{ path('app_property_delete', {id: property.id}) }}" class="inline" onsubmit="return confirm('Supprimer ce logement ?')">
                        <button type="submit" class="text-btn text-btn--danger">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="data-table__empty">Aucun logement</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}