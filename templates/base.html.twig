<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}DP Services{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    {% block stylesheets %}{% endblock %}
    {{ encore_entry_link_tags('app') }}
</head>
<body>

    <aside class="sidebar">
        <h2>DP Services</h2>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin') }}" {% if app.request.get('_route') == 'app_admin' %}class="active"{% endif %}>⚙️ Admin</a>
            <a href="{{ path('app_users') }}" {% if app.request.get('_route') starts with 'app_user' %}class="active"{% endif %}>👥 Utilisateurs</a>
            <a href="{{ path('app_properties') }}" {% if app.request.get('_route') starts with 'app_propert' %}class="active"{% endif %}>🏠 Logements</a>
            <a href="{{ path('app_services') }}" {% if app.request.get('_route') starts with 'app_service' %}class="active"{% endif %}>🧹 Prestations</a>
            <a href="{{ path('app_requests') }}" {% if app.request.get('_route') starts with 'app_request' %}class="active"{% endif %}>📋 Demandes</a>
            <a href="{{ path('app_calendar') }}" {% if app.request.get('_route') == 'app_calendar' %}class="active"{% endif %}>📅 Calendrier</a>
            <a href="{{ path('app_logs') }}" {% if app.request.get('_route') == 'app_logs' %}class="active"{% endif %}>📜 Historique</a>
            <a href="{{ path('app_acquisition') }}" {% if app.request.get('_route') starts with 'app_acquisition' or app.request.get('_route') starts with 'app_lead' %}class="active"{% endif %}>🎯 Acquisition</a>
        {% elseif is_granted('ROLE_OWNER') %}
            <a href="{{ path('app_owner') }}" {% if app.request.get('_route') == 'app_owner' %}class="active"{% endif %}>👤 Mon espace</a>
            <a href="#">🏠 Mes logements</a>
            <a href="#">📋 Mes demandes</a>
            <a href="{{ path('app_calendar') }}" {% if app.request.get('_route') == 'app_calendar' %}class="active"{% endif %}>📅 Calendrier</a>
        {% elseif is_granted('ROLE_CLEANER') %}
            <a href="{{ path('app_cleaner') }}" {% if app.request.get('_route') == 'app_cleaner' %}class="active"{% endif %}>🧹 Mes missions</a>
            <a href="{{ path('app_calendar') }}" {% if app.request.get('_route') == 'app_calendar' %}class="active"{% endif %}>📅 Calendrier</a>
        {% endif %}
    </aside>

    <div class="main">
        <div class="topbar">
            <h1>{% block page_title %}DP Services{% endblock %}</h1>
            <div class="user-info">
                {% if app.user %}
                    <span>{{ app.user.firstname }} {{ app.user.lastname }}</span>
                    <a href="{{ path('app_logout') }}" class="logout">Déconnexion</a>
                {% endif %}
            </div>
        </div>

        <div class="content">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div style="
                        padding: 0.75rem 1.5rem;
                        margin-bottom: 1rem;
                        border-radius: 6px;
                        font-weight: 500;
                        background: {{ type == 'success' ? '#d1fae5' : '#fee2e2' }};
                        color: {{ type == 'success' ? '#059669' : '#dc2626' }};
                        border: 1px solid {{ type == 'success' ? '#6ee7b7' : '#fca5a5' }};
                    ">
                        {{ type == 'success' ? '✅' : '❌' }} {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </div>

    {% block javascripts %}{% endblock %}
    {{ encore_entry_script_tags('app') }}

</body>
</html>