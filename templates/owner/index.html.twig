{% extends 'base.html.twig' %}

{% block title %}Mon espace — DP Services{% endblock %}
{% block page_title %}Mon espace propriétaire{% endblock %}

{% block body %}

    {# ── Mes logements ── #}
    <div class="mb-xl">
        <h2 class="section-title">🏠 Mes logements ({{ properties|length }})</h2>

        {% if properties is empty %}
            <div class="empty-state empty-state--card">
                Aucun logement associé à votre compte.
            </div>
        {% else %}
            <div class="card-grid">
                {% for property in properties %}
                    <div class="card card--accent" style="border-left-color:{{ property.color }};">
                        <h3 class="card-title mb-sm">{{ property.name }}</h3>
                        <p class="text-secondary text-secondary--sm">📍 {{ property.city }}</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ── Mes demandes ── #}
    <div>
        <h2 class="section-title">📋 Mes demandes ({{ requests|length }})</h2>

        {% if requests is empty %}
            <div class="empty-state empty-state--card">
                Aucune demande en cours.
            </div>
        {% else %}
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Logement</th>
                        <th>Prestation</th>
                        <th>Date</th>
                        <th>Heure</th>
                        <th>Femme de ménage</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for req in requests %}
                    <tr>
                        <td>
                            <span class="color-dot" style="background:{{ req.property.color }};"></span>
                            {{ req.property.name }}
                        </td>
                        <td>{{ req.service.name }}</td>
                        <td>{{ req.scheduledDate|date('d/m/Y') }}</td>
                        <td>{{ req.scheduledTime|date('H:i') }}</td>
                        <td>{{ req.assignedCleaner ? req.assignedCleaner.firstname ~ ' ' ~ req.assignedCleaner.lastname : '—' }}</td>
                        <td>
                            {% if req.status == 'PENDING' %}
                                <span class="status-badge status-badge--sm status-badge--caution">En attente</span>
                            {% elseif req.status == 'VALIDATED' %}
                                <span class="status-badge status-badge--sm status-badge--success">Validée</span>
                            {% elseif req.status == 'COMPLETED' %}
                                <span class="status-badge status-badge--sm status-badge--info">Terminée</span>
                            {% elseif req.status == 'CANCELLED' %}
                                <span class="status-badge status-badge--sm status-badge--danger">Annulée</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

{% endblock %}