{# templates/owner/_bottom_nav.html.twig #}
{% set currentRoute = app.request.get('_route') %}

<nav class="mobile-bottom-nav">

    <a href="{{ path('app_owner') }}" class="{{ currentRoute == 'app_owner' ? 'active' : '' }}">
        <i class="fa-solid fa-house"></i>
        <span>Accueil</span>
    </a>

    <a href="{{ path('app_owner_properties') }}" class="{{ currentRoute == 'app_owner_properties' ? 'active' : '' }}">
