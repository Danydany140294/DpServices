{# templates/owner/requests.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes demandes — DP Services</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body class="has-bottom-nav">

    <header class="mobile-topbar">
        <div class="mobile-topbar-logo">
            <img src="{{ asset('assets/images/logologo.png') }}" alt="DP Services">
        </div>
        <div class="mobile-topbar-actions">
            <div class="topbar-notif-wrapper">
                <button class="mobile-topbar-btn" type="button" aria-label="Notifications"
                        onclick="document.getElementById('notif-dropdown').classList.toggle('is-open')">
                    <i class="fa-solid fa-bell"></i>
                    {% set unreadCount = unread_notifications_count(app.user) %}
                    {% if unreadCount > 0 %}
                        <span class="topbar-badge">{{ unreadCount }}</span>
                    {% endif %}
                </button>

                <div id="notif-dropdown" class="topbar-notif-dropdown">
                    {% set recentNotifs = recent_notifications(app.user, 8) %}
                    {% if recentNotifs is empty %}
                        <div class="topbar-notif-empty">Aucune notification</div>
                    {% else %}
                        {% for notif in recentNotifs %}
                            <a href="{{ notif.link ?: '#' }}"
                               class="topbar-notif-item {{ notif.isRead ? '' : 'topbar-notif-item--unread' }}">
                                <span class="topbar-notif-message">{{ notif.message }}</span>
                                <span class="topbar-notif-date">{{ notif.createdAt|date('d/m H:i') }}</span>
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            {% if app.user %}
                <span class="mobile-topbar-avatar">
                    {{ app.user.firstname|first }}{{ app.user.lastname|first }}
                </span>

                <a href="{{ path('app_logout') }}"
                   class="mobile-topbar-btn"
                   title="Déconnexion">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            {% endif %}
        </div>
    </header>

    <div class="mobile-content">

        <h2 class="section-title">
            📋 Mes demandes ({{ requests|length }})
        </h2>

        <div class="requests-actions u-mb-1">
            <a href="{{ path('app_owner_request_new') }}" class="btn btn--primary">
                <i class="fa-solid fa-plus"></i>
                Nouvelle demande
            </a>
        </div>

        {% if requests is empty %}

            <div class="empty-state">
                <div class="emoji">✅</div>
                <p>Aucune demande en cours.</p>
            </div>

        {% else %}

            <div class="mission-list">

                {% for req in requests %}

<div class="mission-row" style="--mission-color: {{ req.property.color }};">

    

    <div class="mission-row__main">

        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;">

            <div class="mission-row__property">
                <span class="color-dot"
                      style="background:{{ req.property.color }};"></span>
                {{ req.property.name }}
            </div>

            {% if req.status == 'PENDING' %}
                <span class="mission-badge mission-badge--pending">En attente</span>
            {% elseif req.status == 'VALIDATED' %}
                <span class="mission-badge mission-badge--upcoming">Validée</span>
            {% elseif req.status == 'COMPLETED' %}
                <span class="mission-badge mission-badge--done">Terminée</span>
            {% elseif req.status == 'CANCELLED' %}
                <span class="status-badge status-badge--sm status-badge--danger">Annulée</span>
            {% endif %}

        </div>

        <div class="mission-row__service">
            {{ req.service.name }}
        </div>

        <div class="mission-row__comment">
    <i class="fa-regular fa-calendar"></i>
    {{ req.scheduledDate|date('d/m') }}

    &nbsp;&nbsp;

    <i class="fa-regular fa-clock"></i>
    {{ req.scheduledTime|date('H:i') }}
</div>

        {% if req.assignedCleaner %}
            <div class="mission-row__comment">
                👤 {{ req.assignedCleaner.firstname }}
                {{ req.assignedCleaner.lastname }}
            </div>
        {% endif %}

        {% if req.status == 'PENDING' %}
            <div class="requests-actions" style="margin-top:8px;">

                <a href="{{ path('app_owner_request_edit', {id:req.id}) }}"
                   class="table-action-link">
                    <i class="fa-solid fa-pen"></i>
                    Modifier
                </a>

                <form method="post"
                      action="{{ path('app_owner_request_cancel', {id:req.id}) }}"
                      class="inline-form"
                      onsubmit="return confirm('Voulez-vous vraiment annuler cette demande ?');">

                    <input type="hidden"
                           name="_token"
                           value="{{ csrf_token('owner_cancel' ~ req.id) }}">

                    <button type="submit"
                            class="table-action-btn table-action-btn--danger">
                        <i class="fa-solid fa-xmark"></i>
                        Annuler
                    </button>

                </form>

            </div>
        {% endif %}

    </div>

</div>

{% endfor %}

            </div>

        {% endif %}

    </div>

    {% include 'owner/_bottom_nav.html.twig' %}

</body>
</html>