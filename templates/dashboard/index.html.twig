<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard — DP Services</title>
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
</head>
<body>

    <aside class="sidebar">
        <h2>DP Services</h2>
        <a href="{{ path('app_dashboard') }}" class="active">🏠 Dashboard</a>
        <a href="#">👤 Propriétaires</a>
        <a href="#">🧹 Femmes de ménage</a>
        <a href="#">🏠 Logements</a>
        <a href="#">📋 Demandes</a>
        <a href="#">📅 Calendrier</a>
    </aside>

    <div class="main">
        <div class="topbar">
            <h1>Tableau de bord</h1>
            <div class="user-info">
                <span>{{ user.firstname }} {{ user.lastname }}</span>
                <a href="{{ path('app_logout') }}" class="logout">Déconnexion</a>
            </div>
        </div>

        <div class="content">
            <div class="cards">
                <div class="card">
                    <h3>Propriétaires</h3>
                    <div class="number">0</div>
                </div>
                <div class="card">
                    <h3>Femmes de ménage</h3>
                    <div class="number">0</div>
                </div>
                <div class="card">
                    <h3>Logements</h3>
                    <div class="number">0</div>
                </div>
                <div class="card">
                    <h3>Demandes en cours</h3>
                    <div class="number">0</div>
                </div>
            </div>

            <div class="welcome">
                <h2>Bienvenue, {{ user.firstname }} ! 👋</h2>
                <p>Vous êtes connecté en tant que <strong>{{ user.roles|join(', ') }}</strong>.</p>
            </div>
        </div>
    </div>

</body>
</html>
