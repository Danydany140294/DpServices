{% extends 'base.html.twig' %}

{% block title %}Historique — DP Services{% endblock %}
{% block page_title %}Historique des actions{% endblock %}

{% block body %}

    <div class="card users-card">
        <div class="users-card__head">
            <h2>Historique</h2>
            <span class="users-count">{{ logs|length }}</span>
        </div>

        {% if logs is empty %}
            <div class="table-wrapper__empty">
                Aucune action enregistrée.
            </div>
        {% else %}
            <table class="data-table users-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Action</th>
                        <th>Détail</th>
                        <th>Par</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                    <tr>
                        <td data-label="Date" class="data-table__date">
                            {{ log.createdAt|date('d/m/Y H:i') }}
                        </td>
                        <td data-label="Action">
                            <span class="badge-action">
                                {{ log.action }}
                            </span>
                        </td>
                        <td data-label="Détail" class="data-table__text">
                            {{ log.description ?? '—' }}
                        </td>
                        <td data-label="Par" class="data-table__text">
                            {{ log.author ? log.author.firstname ~ ' ' ~ log.author.lastname : 'Système' }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

{% endblock %}