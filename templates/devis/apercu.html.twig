{% extends 'base.html.twig' %}

{% block title %}Devis N°{{ devis.id }}{% endblock %}
{% block page_title %}Devis N°{{ devis.id }} — {{ devis.lead.companyName }}{% endblock %}

{% block body %}
<div class="page-container--narrow stack">

    {# Statut + actions #}
    <div class="card-lg devis-header">
    <div>
        <span class="devis-header__date">Créé le {{ devis.createdAt|date('d/m/Y') }}</span>
        {% set statusClasses = {
            'brouillon': 'status-pill-sm--brouillon',
            'envoye': 'status-pill-sm--envoye',
            'accepte': 'status-pill-sm--accepte',
            'refuse': 'status-pill-sm--refuse'
        } %}
        <span class="status-pill-sm {{ statusClasses[devis.status] ?? 'status-pill-sm--default' }}">
            {{ devis.status|upper }}
        </span>

        {# Alerte relance +5 jours #}
        {% if devis.status == 'envoye' and devis.sentAt %}
            {% set jours = date().diff(devis.sentAt).days %}
            {% if jours >= 5 %}
                <span class="alert-pill">
                    ⚠️ Envoyé il y a {{ jours }}j — Pensez à relancer !
                </span>
            {% endif %}
        {% endif %}
    </div>

    <div class="devis-header__actions">
        <a href="{{ path('devis_pdf', {id: devis.id}) }}" target="_blank"
           class="btn-action btn-action--neutral">
            📄 Voir PDF
        </a>

        {% if devis.status == 'brouillon' %}
            <form method="post" action="{{ path('devis_envoyer', {id: devis.id}) }}"
                  onsubmit="return confirm('Envoyer le devis à {{ devis.lead.email }} ?')" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('envoyer' ~ devis.id) }}">
                <button type="submit"
                        class="btn-action btn-action--confirm">
                    ✉️ Envoyer par email
                </button>
            </form>
        {% elseif devis.status == 'envoye' %}
            <form method="post" action="{{ path('devis_accepter', {id: devis.id}) }}"
                  onsubmit="return confirm('Marquer ce devis comme accepté ?')" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('accepter' ~ devis.id) }}">
                <button type="submit"
                        class="btn-action btn-action--success">
                    ✅ Accepté
                </button>
            </form>
            <form method="post" action="{{ path('devis_refuser', {id: devis.id}) }}"
                  onsubmit="return confirm('Marquer ce devis comme refusé ?')" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('refuser' ~ devis.id) }}">
                <button type="submit"
                        class="btn-action btn-action--danger">
                    ❌ Refusé
                </button>
            </form>
        {% else %}
            <span class="btn-action btn-action--disabled">
                {{ devis.status == 'accepte' ? '✅ Accepté' : '❌ Refusé' }}
            </span>
        {% endif %}
    </div>
</div>

    {# Lignes #}
    <div class="devis-table-wrapper">
        <table class="devis-table">
            <thead>
                <tr>
                    <th>Prestation</th>
                    <th class="th--center">Qté</th>
                    <th class="th--right">Prix unit.</th>
                    <th class="th--right">Total</th>
                </tr>
            </thead>
            <tbody>
            {% for ligne in devis.devisLignes %}
            <tr>
                <td>
                    <div class="devis-line__title">{{ ligne.tarifPrestation.nom }}</div>
                    {% if ligne.description %}
                        <div class="devis-line__desc">{{ ligne.description }}</div>
                    {% endif %}
                </td>
                <td class="td--center">{{ ligne.quantite }}</td>
                <td class="td--right">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                <td class="td--right td--bold">{{ (ligne.prixUnitaire * ligne.quantite)|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endfor %}
            </tbody>
            <tfoot>
                {% if devis.discount %}
                <tr>
                    <td colspan="3" class="devis-total-label">Sous-total</td>
                    <td class="td--right">{{ devis.total|number_format(2, ',', ' ') }} €</td>
                </tr>
                <tr>
                    <td colspan="3" class="devis-total-label--discount">Remise</td>
                    <td class="devis-total-value--discount">-{{ devis.discount|number_format(2, ',', ' ') }} €</td>
                </tr>
                {% endif %}
                <tr>
                    <td colspan="3" class="devis-grand-total-label">TOTAL</td>
                    <td class="devis-grand-total-value">
                        {{ (devis.total - (devis.discount ?? 0))|number_format(2, ',', ' ') }} €
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    {% if devis.notes %}
    <div class="card-lg">
        <div class="notes-block__title">Notes</div>
        <div class="notes-block__text">{{ devis.notes }}</div>
    </div>
    {% endif %}

</div>
{% endblock %}
