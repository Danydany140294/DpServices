{% extends 'base.html.twig' %}

{% block title %}Nouveau devis — {{ lead.companyName }}{% endblock %}
{% block page_title %}Nouveau devis — {{ lead.companyName }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">

    {# Infos prospect #}
    <div class="bg-white rounded-xl shadow p-5 mb-6 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-700 font-bold text-lg">
            {{ lead.companyName|first|upper }}
        </div>
        <div>
            <div class="font-semibold text-gray-800">{{ lead.companyName }}</div>
            <div class="text-sm text-gray-500">{{ lead.city }} · {{ lead.email }}</div>
        </div>
    </div>

    <form method="POST" id="devis-form">
    <div class="grid grid-cols-1 gap-6">

        {# Sélection prestations #}
        <div class="bg-white rounded-xl shadow p-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Prestations</h2>

            {% set categories = {
                'menage_standard': 'Ménage Standard',
                'option': 'Options Recommandées',
                'specifique': 'Prestations Spécifiques',
                'conciergerie': 'Options Conciergerie'
            } %}

            {% for catKey, catLabel in categories %}
            <div class="mb-6">
                <h3 class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-3 border-b border-green-100 pb-1">
                    {{ catLabel }}
                </h3>
                <div class="space-y-2">
                {% for tarif in tarifs %}
                {% if tarif.categorie == catKey %}
                <div class="flex items-center gap-3 p-3 rounded-lg border border-gray-100 hover:border-green-200 hover:bg-green-50 transition">
                    <input type="checkbox" name="tarif_id[]" value="{{ tarif.id }}"
                           id="tarif_{{ tarif.id }}"
                           class="tarif-checkbox w-4 h-4 text-green-600 rounded"
                           data-prix="{{ tarif.prix }}"
                           data-nom="{{ tarif.nom }}"
                           {% if tarif.surDevis %}disabled{% endif %}>
                    <label for="tarif_{{ tarif.id }}" class="flex-1 cursor-pointer">
                        <span class="font-medium text-gray-800">{{ tarif.nom }}</span>
                        {% if tarif.description %}
                            <span class="text-xs text-gray-400 block">{{ tarif.description }}</span>
                        {% endif %}
                    </label>
                    {% if tarif.surDevis %}
                        <span class="text-xs text-orange-500 font-medium">Sur devis</span>
                    {% else %}
                        <span class="text-green-700 font-semibold">{{ tarif.prix }}€</span>
                        <span class="text-xs text-gray-400">{{ tarif.unite }}</span>
                    {% endif %}
                    <input type="number" name="quantite[]" value="1" min="1" max="99"
                           class="w-14 text-center border border-gray-200 rounded px-1 py-1 text-sm quantite-input"
                           {% if tarif.surDevis %}disabled{% endif %}>
                </div>
                {% endif %}
                {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        {# Remise + Notes #}
        <div class="bg-white rounded-xl shadow p-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Options</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Remise (€)</label>
                    <input type="number" name="discount" min="0" step="0.5"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"
                           placeholder="0">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                    <textarea name="notes" rows="2"
                              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"
                              placeholder="Remarques éventuelles..."></textarea>
                </div>
            </div>
        </div>

        {# Aperçu total #}
        <div class="bg-green-700 text-white rounded-xl shadow p-5 flex items-center justify-between">
            <div>
                <div class="text-sm opacity-80">Total estimé</div>
                <div class="text-3xl font-bold" id="total-display">0,00 €</div>
            </div>
            <button type="submit"
                    class="bg-white text-green-700 font-semibold px-6 py-3 rounded-lg hover:bg-green-50 transition">
                Créer le devis →
            </button>
        </div>

    </div>
    </form>
</div>

<script>
function updateTotal() {
    let total = 0;
    document.querySelectorAll('.tarif-checkbox:checked').forEach(cb => {
        const prix = parseFloat(cb.dataset.prix) || 0;
        const row = cb.closest('div.flex');
        const qte = parseInt(row.querySelector('.quantite-input').value) || 1;
        total += prix * qte;
    });
    const discount = parseFloat(document.querySelector('[name="discount"]').value) || 0;
    total = Math.max(0, total - discount);
    document.getElementById('total-display').textContent = total.toFixed(2).replace('.', ',') + ' €';
}

document.querySelectorAll('.tarif-checkbox, .quantite-input, [name="discount"]').forEach(el => {
    el.addEventListener('change', updateTotal);
    el.addEventListener('input', updateTotal);
});
</script>
{% endblock %}