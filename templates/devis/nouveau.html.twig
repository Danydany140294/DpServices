{% extends 'base.html.twig' %}

{% block title %}Nouveau devis — {{ lead.companyName }}{% endblock %}
{% block page_title %}Nouveau devis — {{ lead.companyName }}{% endblock %}

{% block body %}
<div class="page-container">

    {# Infos prospect #}
    <div class="lead-banner">
        <div class="lead-banner__avatar">
            {{ lead.companyName|first|upper }}
        </div>
        <div>
            <div class="lead-banner__name">{{ lead.companyName }}</div>
            <div class="lead-banner__meta">{{ lead.city }} · {{ lead.email }}</div>
        </div>
    </div>

    {# Bouton Suggestions IA #}
    <div class="ai-suggest-bar">
        <form method="post" action="{{ path('app_lead_ai_suggest', {id: lead.id}) }}">
            <button type="submit" class="btn-ai">
                🤖 Suggestions IA
            </button>
        </form>
    </div>

    {# Bandeau explication IA #}
    {% if aiSummary is defined and aiSummary %}
    <div class="ai-banner">
        🤖 <strong>Suggestions IA :</strong> {{ aiSummary }}
    </div>
    {% endif %}

    <form method="POST" id="devis-form">
    <div class="form-stack">

        {# Sélection prestations #}
        <div class="form-section">
            <h2 class="form-section__title">Prestations</h2>

            {% set categories = {
                'menage_standard': 'Ménage Standard',
                'option': 'Options Recommandées',
                'specifique': 'Prestations Spécifiques',
                'conciergerie': 'Options Conciergerie'
            } %}

            {% for catKey, catLabel in categories %}
            <div class="tarif-category">
                <h3 class="tarif-category__title">
                    {{ catLabel }}
                </h3>
                <div class="tarif-list">
                {% for tarif in tarifs %}
                {% if tarif.categorie == catKey %}
                <div class="tarif-row">
                    <input type="checkbox" name="tarif_id[]" value="{{ tarif.id }}"
                           id="tarif_{{ tarif.id }}"
                           class="tarif-checkbox tarif-row__checkbox"
                           data-prix="{{ tarif.prix }}"
                           data-nom="{{ tarif.nom }}"
                           {% if tarif.surDevis %}disabled{% endif %}
                           {% if aiSuggestions is defined and tarif.nom in aiSuggestions %}checked{% endif %}>
                    <label for="tarif_{{ tarif.id }}" class="tarif-row__label">
                        <span class="tarif-row__name">{{ tarif.nom }}</span>
                        {% if tarif.description %}
                            <span class="tarif-row__desc">{{ tarif.description }}</span>
                        {% endif %}
                    </label>
                    {% if aiSuggestions is defined and tarif.nom in aiSuggestions %}
                        <span class="tarif-row__ai-badge">✨ IA</span>
                    {% endif %}
                    {% if tarif.surDevis %}
                        <span class="tarif-row__on-quote">Sur devis</span>
                    {% else %}
                        <span class="tarif-row__price">{{ tarif.prix }}€</span>
                        <span class="tarif-row__unit">{{ tarif.unite }}</span>
                    {% endif %}
                    <input type="number" name="quantite[]" value="1" min="1" max="99"
                           class="quantite-input tarif-row__qty-input"
                           {% if tarif.surDevis %}disabled{% endif %}>
                </div>
                {% endif %}
                {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        {# Remise + Notes #}
        <div class="form-section">
            <h2 class="form-section__title">Options</h2>
            <div class="form-grid-2">
                <div>
                    <label class="form-field__label">Remise (€)</label>
                    <input type="number" name="discount" min="0" step="0.5"
                           class="form-field__input"
                           placeholder="0">
                </div>
                <div>
                    <label class="form-field__label">Notes</label>
                    <textarea name="notes" rows="2"
                              class="form-field__input"
                              placeholder="Remarques éventuelles..."></textarea>
                </div>
            </div>
        </div>

        {# Aperçu total #}
        <div class="total-banner">
            <div>
                <div class="total-banner__label">Total estimé</div>
                <div class="total-banner__value" id="total-display">0,00 €</div>
            </div>
            <button type="submit"
                    class="btn-create-devis">
                Créer le devis →
            </button>
        </div>

    </div>
    </form>
</div>

<script>
function updateTotal() {
    let total = 0;
    document.querySelectorAll('.tarif-checkbox:checked').forEach(cb => {
        const prix = parseFloat(cb.dataset.prix) || 0;
        const row = cb.closest('.tarif-row');
        const qte = parseInt(row.querySelector('.quantite-input').value) || 1;
        total += prix * qte;
    });
    const discount = parseFloat(document.querySelector('[name="discount"]').value) || 0;
    total = Math.max(0, total - discount);
    document.getElementById('total-display').textContent = total.toFixed(2).replace('.', ',') + ' €';
}

document.querySelectorAll('.tarif-checkbox, .quantite-input, [name="discount"]').forEach(el => {
    el.addEventListener('change', updateTotal);
    el.addEventListener('input', updateTotal);
});

// Calcule le total au chargement si des cases sont pré-cochées par l'IA
updateTotal();
</script>
{% endblock %}
