<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #333; margin: 0; padding: 20px; }
    .header { display: table; width: 100%; margin-bottom: 30px; }
    .header-left { display: table-cell; width: 60%; }
    .header-right { display: table-cell; width: 40%; text-align: right; color: #2d6a4f; }
    h1 { color: #2d6a4f; font-size: 28px; margin: 0 0 5px 0; }
    .company-name { font-size: 18px; font-weight: bold; color: #2d6a4f; }
    .company-contact { color: #888; font-size: 11px; margin-top: 4px; }
    .badge { background: #2d6a4f; color: white; padding: 4px 12px; border-radius: 4px; font-size: 11px; display: inline-block; margin-bottom: 10px; }
    .header-status { margin-top: 8px; }
    .info-block { margin-bottom: 25px; }
    .info-block table { width: 100%; }
    .info-block td { padding: 3px 0; }
    .label { color: #888; width: 120px; }
    table.prestations { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    table.prestations th { background: #2d6a4f; color: white; padding: 8px 10px; text-align: left; }
    table.prestations th.col-unite { width: 20%; }
    table.prestations th.col-qte { width: 10%; text-align: center; }
    table.prestations th.col-prix { width: 20%; text-align: right; }
    table.prestations th.col-prestation { width: 50%; }
    table.prestations td { padding: 8px 10px; border-bottom: 1px solid #eee; }
    table.prestations td.col-qte { text-align: center; }
    table.prestations td.col-prix { text-align: right; }
    table.prestations tr:nth-child(even) td { background: #f9f9f9; }
    .ligne-desc { color: #888; font-size: 10px; }
    .total-block { text-align: right; margin-top: 10px; }
    .total-line { font-size: 14px; margin-bottom: 5px; }
    .total-line--discount { color: #e74c3c; }
    .total-final { font-size: 18px; font-weight: bold; color: #2d6a4f; border-top: 2px solid #2d6a4f; padding-top: 8px; margin-top: 8px; }
    .tva-mention { color: #888; font-size: 10px; margin-top: 5px; }
    .statut { display: inline-block; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: bold; }
    .statut-brouillon { background: #fef3c7; color: #92400e; }
    .statut-envoye { background: #dbeafe; color: #1e40af; }
    .statut-accepte { background: #d1fae5; color: #065f46; }
    .statut-refuse { background: #fee2e2; color: #991b1b; }
    .footer { margin-top: 40px; border-top: 1px solid #eee; padding-top: 15px; color: #888; font-size: 10px; text-align: center; }
    .notes { background: #f8f9fa; border-left: 3px solid #2d6a4f; padding: 10px 15px; margin-top: 20px; font-size: 11px; }
</style>
</head>
<body>

<div class="header">
    <div class="header-left">
        <div class="company-name">DP Services Sud</div>
        <div class="company-contact">
            06 08 12 81 03<br>
            Dpservicesud@gmail.com<br>
            Disponible 7j/7 — Intervention rapide
        </div>
    </div>
    <div class="header-right">
        <h1>DEVIS</h1>
        <div>N° {{ devis.id }}</div>
        <div>{{ devis.createdAt|date('d/m/Y') }}</div>
        <div class="header-status">
            <span class="statut statut-{{ devis.status }}">{{ devis.status|upper }}</span>
        </div>
    </div>
</div>

<div class="info-block">
    <strong>Prospect / Client</strong>
    <table>
        <tr>
            <td class="label">Entreprise</td>
            <td>{{ devis.lead.companyName }}</td>
        </tr>
        <tr>
            <td class="label">Contact</td>
            <td>{{ devis.lead.contactName }}</td>
        </tr>
        <tr>
            <td class="label">Email</td>
            <td>{{ devis.lead.email }}</td>
        </tr>
        <tr>
            <td class="label">Téléphone</td>
            <td>{{ devis.lead.phone }}</td>
        </tr>
        <tr>
            <td class="label">Ville</td>
            <td>{{ devis.lead.city }}</td>
        </tr>
    </table>
</div>

<table class="prestations">
    <thead>
        <tr>
            <th class="col-prestation">Prestation</th>
            <th class="col-unite">Unité</th>
            <th class="col-qte">Qté</th>
            <th class="col-prix">Prix HT</th>
        </tr>
    </thead>
    <tbody>
        {% for ligne in devis.devisLignes %}
        <tr>
            <td>
                {{ ligne.tarifPrestation.nom }}
                {% if ligne.description %}
                    <br><span class="ligne-desc">{{ ligne.description }}</span>
                {% endif %}
            </td>
            <td>{{ ligne.tarifPrestation.unite }}</td>
            <td class="col-qte">{{ ligne.quantite }}</td>
            <td class="col-prix">{{ (ligne.prixUnitaire * ligne.quantite)|number_format(2, ',', ' ') }} €</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div class="total-block">
    {% set subtotal = devis.total %}
    {% if devis.discount %}
        <div class="total-line">Sous-total : {{ subtotal|number_format(2, ',', ' ') }} €</div>
        <div class="total-line total-line--discount">Remise : -{{ devis.discount|number_format(2, ',', ' ') }} €</div>
        <div class="total-final">TOTAL : {{ (subtotal - devis.discount)|number_format(2, ',', ' ') }} €</div>
    {% else %}
        <div class="total-final">TOTAL : {{ subtotal|number_format(2, ',', ' ') }} €</div>
    {% endif %}
    <div class="tva-mention">TVA non applicable — Art. 293 B du CGI</div>
</div>

{% if devis.notes %}
<div class="notes">
    <strong>Notes :</strong><br>{{ devis.notes }}
</div>
{% endif %}

<div class="footer">
    DP Services Sud · 06 08 12 81 03 · Dpservicesud@gmail.com · Disponible 7j/7<br>
    Devis valable 30 jours à compter de sa date d'émission.
</div>

</body>
</html>
