{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ encore_entry_link_tags('calendar') }}
{% endblock %}

{% block title %}Admin — DP Services{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block body %}

    {# ════════════════════════════════════════════════════════════════
       KPIs PRINCIPAUX (version enrichie : icône + valeur + tendance)

       Demandes en attente / Missions du jour : branchés sur les
       vraies données du AdminController (pendingRequests,
       missionsAujourdhuiCount).

       ⚠️ CONTROLLER : Revenus (mois) et Taux de satisfaction n'ont pas
       de source de données dans le projet actuel (pas de champ "prix"
       sur CleaningRequest/CleaningService, pas de système de notation
       client). Laissés en valeurs statiques pour l'instant — à
       remplacer quand ces fonctionnalités existeront, ou à retirer
       ces 2 cartes et repasser .dash-kpis sur 2 colonnes seulement.

       Les pourcentages de tendance (-15%, +10%...) sont aussi statiques :
       un vrai calcul demanderait de comparer aux données de la semaine/
       du mois précédent (ex: compter les pendingRequests d'il y a 7
       jours). Retiré pour l'instant pour ne pas afficher un chiffre
       inventé qui n'aurait pas de sens métier réel. -- #}
    <div class="dash-kpis">

        <div class="dash-kpi">
            <div class="dash-kpi-icon dash-kpi-icon--gold"><i class="fa-solid fa-clipboard-list"></i></div>
            <div class="dash-kpi-value">{{ pendingRequests }}</div>
            <div class="dash-kpi-label">Demandes en attente</div>
        </div>

        <div class="dash-kpi">
            <div class="dash-kpi-icon dash-kpi-icon--teal"><i class="fa-solid fa-calendar-day"></i></div>
            <div class="dash-kpi-value">{{ missionsAujourdhuiCount }}</div>
            <div class="dash-kpi-label">Missions du jour</div>
        </div>

        {# ⚠️ CONTROLLER : valeurs statiques, voir note ci-dessus #}
        <div class="dash-kpi">
            <div class="dash-kpi-icon dash-kpi-icon--blue"><i class="fa-solid fa-wallet"></i></div>
            <div class="dash-kpi-value">—</div>
            <div class="dash-kpi-label">Revenus (mois)</div>
        </div>

        <div class="dash-kpi">
            <div class="dash-kpi-icon dash-kpi-icon--purple"><i class="fa-solid fa-star"></i></div>
            <div class="dash-kpi-value">—</div>
            <div class="dash-kpi-label">Taux de satisfaction</div>
        </div>

    </div>

    {# ════════════════════════════════════════════════════════════════
       CALENDRIER (semaine) + DEMANDES À VALIDER
       ⚠️ CONTROLLER : voir détail des variables dans chaque bloc.
       ════════════════════════════════════════════════════════════════ #}
    <div class="dash-row dash-row--3-2">

        {# -- Mini calendrier de la semaine --
           ⚠️ CONTROLLER : `jours` doit être un tableau de 7 entrées
           [{ code: 'LUN', num: 19, active: false, overflow: false }, ...]
           représentant la semaine en cours.
           `evenements` : [{ day: 0..6, mode: 'positioned'|'stacked',
           top: <% position>, color: '#RRGGBB' (couleur du logement,
           identique à la page Calendrier), title: '...',
           place: '...' (seulement en mode positioned) }].
           `missionsDebordantes` : détail des jours ayant 4+ missions,
           affiché sous la grille plutôt que dans les cases du calendrier. -- #}
        <div class="card">
            <div class="dash-card-head">
                <h3>Calendrier <span class="dim">— Aperçu de la semaine</span></h3>
                <a href="{{ path('app_calendar') }}" class="dash-link">Voir le calendrier</a>
            </div>

            <div class="dash-cal-days">
                <div></div>
                {% for j in jours|default([
                    { code: 'LUN', num: 19 }, { code: 'MAR', num: 20, active: true },
                    { code: 'MER', num: 21 }, { code: 'JEU', num: 22 },
                    { code: 'VEN', num: 23 }, { code: 'SAM', num: 24 },
                    { code: 'DIM', num: 25 }
                ]) %}
                    <div class="dash-cal-day{% if j.active|default(false) %} active{% endif %}">
                        <div class="dn">{{ j.code }}</div>
                        <div class="num">{{ j.num }}</div>
                        {% if j.overflow|default(false) %}
                            <div style="width:5px;height:5px;border-radius:50%;background:var(--gold);margin:3px auto 0;"></div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            <div class="dash-cal-grid">
                {% for h in ['09:00', '12:00', '15:00', '18:00'] %}
                    <div class="dash-hour-line" style="top:{{ (loop.index0 + 0.5) * 25 }}%">
                        <div class="h">{{ h }}</div><div class="l"></div>
                    </div>
                {% endfor %}
                <div class="dash-cal-cols">
                    {% set evenementsList = evenements|default([]) %}
                    {% for col in 0..6 %}
                        <div class="dash-cal-col">
                            {% for e in evenementsList %}
                                {% if e.day == col %}
                                    {% if e.mode == 'stacked' %}
                                        <div class="dash-event dash-event--stacked" style="top:{{ e.top }}%; background:{{ e.color }}; border-color:{{ e.color }}; color:#fff;">
                                            <div class="t">{{ e.title }}</div>
                                        </div>
                                    {% else %}
                                        <div class="dash-event" style="top:{{ e.top }}%; background:{{ e.color }}; border-color:{{ e.color }}; color:#fff;">
                                            <div class="t">{{ e.title }}</div>
                                            <div class="p">{{ e.place }}</div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if missionsDebordantes|default([])|length > 0 %}
                <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border-soft);">
                    <div style="font-size:11px;color:var(--text-dim);margin-bottom:8px;">Missions supplémentaires (4+ le même jour)</div>
                    <div style="display:flex;flex-direction:column;gap:6px;">
                        {% for m in missionsDebordantes %}
                            <div style="display:flex;align-items:center;gap:8px;font-size:11px;color:var(--text);">
                                <span style="width:6px;height:6px;border-radius:50%;background:{{ m.color }};flex-shrink:0;"></span>
                                <span style="color:var(--text-dim);min-width:32px;">{{ m.dayLabel }}</span>
                                <span style="color:var(--text-dim);">{{ m.time }}</span>
                                <span>{{ m.title }}</span>
                                <span style="color:var(--text-dim);">— {{ m.place }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

    </div>

    {# ════════════════════════════════════════════════════════════════
       MISSIONS ASSIGNÉES + DEMANDES À VALIDER + MESSAGES + HISTORIQUE
       ════════════════════════════════════════════════════════════════ #}
    <div class="dash-row dash-row--3">

        {# -- Missions assignées aujourd'hui -- #}
        <div class="card">
            <div class="dash-card-head">
                <h3>Missions assignées</h3>
                <a href="{{ path('app_calendar') }}" class="dash-link">Voir tout ({{ missionsAujourdhuiCount }})</a>
            </div>
            <ul class="dash-list">
                {% for m in missionsAssigneesToday %}
                    <li class="dash-row-item">
                        <div class="dash-ri-avatar">
                            {% if m.assignedCleaner %}
                                {{ m.assignedCleaner.firstname|first }}{{ m.assignedCleaner.lastname|first }}
                            {% else %}
                                <i class="fa-solid fa-user-slash" style="font-size:11px"></i>
                            {% endif %}
                        </div>
                        <div class="dash-ri-body">
                            <div class="dash-ri-name">
                                {% if m.assignedCleaner %}
                                    {{ m.assignedCleaner.firstname }} {{ m.assignedCleaner.lastname }}
                                {% else %}
                                    Non assigné
                                {% endif %}
                            </div>
                            <div class="dash-ri-sub">{{ m.property.name }} — {{ m.service.name }}</div>
                        </div>
                        <div class="dash-ri-time"><i class="fa-regular fa-clock" style="font-size:10px"></i> {{ m.scheduledTime|date('H:i') }}</div>
                        {% if m.status == 'VALIDATED' %}
                            <span class="dash-pill gold">Confirmée</span>
                        {% elseif m.status == 'COMPLETED' %}
                            <span class="dash-pill muted">Terminée</span>
                        {% else %}
                            <span class="dash-pill muted">{{ m.status }}</span>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="dash-li-sub" style="padding:12px 0;">Aucune mission assignée aujourd'hui.</li>
                {% endfor %}
            </ul>
        </div>

        {# -- Demandes à valider -- #}
        <div class="card">
            <div class="dash-card-head">
                <h3>Demandes à valider</h3>
                <a href="{{ path('app_requests') }}" class="dash-link">Tout voir ({{ pendingRequests }})</a>
            </div>
            <ul class="dash-list">
                {% for d in demandesAValider %}
                    <li class="dash-list-item">
                        <div class="dash-li-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                        <div class="dash-li-body">
                            <div class="dash-li-title">{{ d.property.name }}</div>
                            <div class="dash-li-sub"><i class="fa-solid fa-location-dot"></i> {{ d.service.name }}</div>
                        </div>
                        <div class="dash-li-time">{{ d.scheduledDate|date('d/m') }}, {{ d.scheduledTime|date('H:i') }}</div>
                        <a href="{{ path('app_request_validate', { id: d.id }) }}" class="dash-btn-validate">Valider</a>
                    </li>
                {% else %}
                    <li class="dash-li-sub" style="padding:12px 0;">Aucune demande en attente.</li>
                {% endfor %}
            </ul>
        </div>

        {# -- Messages récents --
           ⚠️ CONTROLLER : nécessite une entité Message/Conversation si
           elle n'existe pas encore dans ton projet. Si la messagerie
           n'est pas encore développée, ce bloc peut être retiré ou
           laissé vide (la boucle ci-dessous gère déjà le cas "aucun
           message" via {% else %}). Champs attendus par entrée :
           initiales, nom, temps, apercu (texte tronqué), non_lus (int). -- #}
        <div class="card">
            <div class="dash-card-head">
                <h3>Messages</h3>
                <a href="#" class="dash-link">Voir tout</a>
            </div>
            <ul class="dash-list">
                {% for msg in messagesRecents|default([]) %}
                    <li class="dash-row-item">
                        <div class="dash-ri-avatar">{{ msg.initiales }}</div>
                        <div class="dash-ri-body">
                            <div class="dash-ri-line1">
                                <div class="dash-ri-name">{{ msg.nom }}</div>
                                <div class="dash-ri-time">{{ msg.temps }}</div>
                            </div>
                            <div class="dash-ri-sub">{{ msg.apercu }}</div>
                        </div>
                        {% if msg.non_lus|default(0) > 0 %}
                            <span class="dash-unread">{{ msg.non_lus }}</span>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="dash-li-sub" style="padding:12px 0;">Aucun message récent.</li>
                {% endfor %}
            </ul>
        </div>

        {# -- Historique récent -- #}
        <div class="card">
            <div class="dash-card-head">
                <h3>Historique</h3>
                <a href="{{ path('app_logs') }}" class="dash-link">Voir tout</a>
            </div>
            <ul class="dash-timeline">
                {% for h in logsRecents %}
                    <li class="dash-tl-item">
                        <div class="dash-tl-title">{{ h.action }}</div>
                        <div class="dash-tl-desc">{{ h.description }}</div>
                        <div class="dash-tl-time">{{ h.createdAt|date('d/m/Y H:i') }}</div>
                    </li>
                {% else %}
                    <li class="dash-li-sub" style="padding:4px 0;">Aucun événement récent.</li>
                {% endfor %}
            </ul>
        </div>

    </div>

    {# ════════════════════════════════════════════════════════════════
       BLOCS EXISTANTS (conservés, réorganisés en bas sur 2 colonnes
       pour s'intégrer au reste du dashboard sans prendre toute la
       largeur — données et logique 100% identiques à l'original)
       ════════════════════════════════════════════════════════════════ #}
    <div class="dash-row--legacy">

        <div class="card">
            <h2 class="section-title">Statuts des demandes</h2>
            <div class="grid-auto status-grid">

                <div class="status-pill status-pill--pending">
                    <div class="status-pill__value">{{ pendingRequests }}</div>
                    <div class="status-pill__label">⏳ En attente</div>
                </div>

                <div class="status-pill status-pill--validated">
                    <div class="status-pill__value">{{ validatedRequests }}</div>
                    <div class="status-pill__label">✅ Validées</div>
                </div>

                <div class="status-pill status-pill--completed">
                    <div class="status-pill__value">{{ completedRequests }}</div>
                    <div class="status-pill__label">🏁 Terminées</div>
                </div>

                <div class="status-pill status-pill--cancelled">
                    <div class="status-pill__value">{{ cancelledRequests }}</div>
                    <div class="status-pill__label">❌ Annulées</div>
                </div>

            </div>
        </div>

    </div>

{% endblock %}
