{% extends 'base.html.twig' %}

{% block title %}Prestations — DP Services{% endblock %}
{% block page_title %}Gestion des prestations{% endblock %}

{% block body %}

    <div class="u-mb-1">
        <a href="{{ path('app_service_new') }}" class="btn-link">
            + Nouvelle prestation
        </a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Durée</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for service in services %}
            <tr>
                <td>{{ service.name }}</td>
                <td>{{ service.duration }} min</td>
                <td>
                    <a href="{{ path('app_service_edit', {id: service.id}) }}" class="table-action-link">Modifier</a>
                    <form method="post" action="{{ path('app_service_delete', {id: service.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer cette prestation ?')">
                        <button type="submit" class="table-action-btn table-action-btn--danger">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="3" class="table-empty-cell">Aucune prestation</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
