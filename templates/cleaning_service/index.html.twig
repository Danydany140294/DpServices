{% extends 'base.html.twig' %}

{% block title %}Prestations — DP Services{% endblock %}
{% block page_title %}Gestion des prestations{% endblock %}

{% block body %}

    <div style="margin-bottom:1rem;">
        <a href="{{ path('app_service_new') }}" style="padding:0.75rem 1.5rem; background:#2563eb; color:white; border-radius:4px; text-decoration:none;">
            + Nouvelle prestation
        </a>
    </div>

    <table style="width:100%; background:white; border-radius:8px; border-collapse:collapse;">
        <thead>
            <tr style="background:#f1f5f9;">
                <th style="padding:1rem; text-align:left;">Nom</th>
                <th style="padding:1rem; text-align:left;">Durée</th>
                <th style="padding:1rem; text-align:left;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for service in services %}
            <tr style="border-top:1px solid #e2e8f0;">
                <td style="padding:1rem;">{{ service.name }}</td>
                <td style="padding:1rem;">{{ service.duration }} min</td>
                <td style="padding:1rem;">
                    <a href="{{ path('app_service_edit', {id: service.id}) }}" style="color:#2563eb; margin-right:1rem;">Modifier</a>
                    <form method="post" action="{{ path('app_service_delete', {id: service.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette prestation ?')">
                        <button type="submit" style="color:#ef4444; background:none; border:none; cursor:pointer;">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="3" style="padding:1rem; text-align:center; color:#94a3b8;">Aucune prestation</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}