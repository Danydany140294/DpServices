{% extends 'base.html.twig' %}

{% block title %}Acquisition — DP Services{% endblock %}
{% block page_title %}Module Acquisition{% endblock %}

{# Pas de <link> ici : app.css est chargé une seule fois dans base.html.twig #}

{% block body %}
    <div class="welcome">
        <h2>🎯 Bienvenue dans le module Acquisition</h2>
        <p>Ce module vous permet de trouver et gérer vos prospects.</p>

        <div class="action-grid">

            <a href="{{ path('app_leads') }}" class="action-card">
                <div class="action-card__icon">👥</div>
                <h3 class="action-card__title">Prospects</h3>
                <p class="action-card__desc">Gérer vos leads</p>
            </a>

            <a href="{{ path('app_lead_search') }}" class="action-card">
                <div class="action-card__icon">🔍</div>
                <h3 class="action-card__title">Recherche</h3>
                <p class="action-card__desc">Trouver des prospects</p>
            </a>

            <a href="{{ path('app_acquisition_dashboard') }}" target="_blank" class="action-card">
                <div class="action-card__icon">📊</div>
                <h3 class="action-card__title">Dashboard</h3>
                <p class="action-card__desc">Statistiques</p>
            </a>

        </div>
    </div>
{% endblock %}
