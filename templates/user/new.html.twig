{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur — DP Services{% endblock %}
{% block page_title %}Créer un utilisateur{% endblock %}

{% block body %}

    <a href="{{ path('app_users') }}" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour aux utilisateurs</a>

    <div class="form-card">
        <div class="form-card__head">
            <div class="form-card__icon"><i class="fa-solid fa-user-plus"></i></div>
            <div>
                <h2>Nouvel utilisateur</h2>
                <p>Renseignez les informations du compte à créer</p>
            </div>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'form-card__body'}}) }}
            <div class="form-grid-2">
                {{ form_row(form.firstname) }}
                {{ form_row(form.lastname) }}
            </div>
            <div class="form-grid-2">
                {{ form_row(form.email) }}
                {{ form_row(form.phone) }}
            </div>
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.roles) }}

            <div class="form-card__actions">
                <button type="submit" class="btn btn--primary btn--lg">
                    <i class="fa-solid fa-check"></i> Créer l'utilisateur
                </button>
                <a href="{{ path('app_users') }}" class="text-secondary text-secondary--spaced">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>

{% endblock %}