{% extends 'base.html.twig' %}

{% block title %}Utilisateurs — DP Services{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block body %}

    <div class="mb-md">
        <a href="{{ path('app_user_new') }}" class="btn btn--primary btn--md">
            + Nouvel utilisateur
        </a>
    </div>

    <div class="mb-xl">
        <h2>Propriétaires ({{ owners|length }})</h2>
        <table class="data-table mt-md">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Créé le</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for owner in owners %}
                <tr class="{{ 'ROLE_DISABLED' in owner.roles ? 'data-table__row--disabled' : '' }}">
                    <td>{{ owner.firstname }} {{ owner.lastname }}</td>
                    <td>{{ owner.email }}</td>
                    <td>{{ owner.phone ?? '-' }}</td>
                    <td>{{ owner.createdAt|date('d/m/Y') }}</td>
                    <td>
                        {% if 'ROLE_DISABLED' in owner.roles %}
                            <span class="status-badge status-badge--sm status-badge--danger">Désactivé</span>
                        {% else %}
                            <span class="status-badge status-badge--sm status-badge--success">Actif</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_user_edit', {id: owner.id}) }}" class="text-link">Modifier</a>
                        <a href="{{ path('app_user_toggle', {id: owner.id}) }}" class="text-link {{ 'ROLE_DISABLED' in owner.roles ? 'text-link--success' : 'text-link--warning' }} ml-sm">
                            {{ 'ROLE_DISABLED' in owner.roles ? 'Activer' : 'Désactiver' }}
                        </a>
                        <form method="post" action="{{ path('app_user_delete', {id: owner.id}) }}" class="inline" onsubmit="return confirm('Supprimer définitivement {{ owner.firstname }} {{ owner.lastname }} ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ owner.id) }}">
                            <button type="submit" class="text-btn text-btn--danger ml-sm">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="data-table__empty">Aucun propriétaire</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div>
        <h2>Femmes de ménage ({{ cleaners|length }})</h2>
        <table class="data-table mt-md">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Créé le</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for cleaner in cleaners %}
                <tr class="{{ 'ROLE_DISABLED' in cleaner.roles ? 'data-table__row--disabled' : '' }}">
                    <td>{{ cleaner.firstname }} {{ cleaner.lastname }}</td>
                    <td>{{ cleaner.email }}</td>
                    <td>{{ cleaner.phone ?? '-' }}</td>
                    <td>{{ cleaner.createdAt|date('d/m/Y') }}</td>
                    <td>
                        {% if 'ROLE_DISABLED' in cleaner.roles %}
                            <span class="status-badge status-badge--sm status-badge--danger">Désactivé</span>
                        {% else %}
                            <span class="status-badge status-badge--sm status-badge--success">Actif</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_user_edit', {id: cleaner.id}) }}" class="text-link">Modifier</a>
                        <a href="{{ path('app_user_toggle', {id: cleaner.id}) }}" class="text-link {{ 'ROLE_DISABLED' in cleaner.roles ? 'text-link--success' : 'text-link--warning' }} ml-sm">
                            {{ 'ROLE_DISABLED' in cleaner.roles ? 'Activer' : 'Désactiver' }}
                        </a>
                        <form method="post" action="{{ path('app_user_delete', {id: cleaner.id}) }}" class="inline" onsubmit="return confirm('Supprimer définitivement {{ cleaner.firstname }} {{ cleaner.lastname }} ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cleaner.id) }}">
                            <button type="submit" class="text-btn text-btn--danger ml-sm">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="data-table__empty">Aucune femme de ménage</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}