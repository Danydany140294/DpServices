{% extends 'base.html.twig' %}

{% block title %}Modifier — DP Services{% endblock %}
{% block page_title %}Modifier {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block body %}
    <div class="welcome">
        {{ form_start(form) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
            {{ form_row(form.email) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.roles) }}
            <button type="submit" class="btn btn--primary btn--lg mt-md">
                Sauvegarder
            </button>
            <a href="{{ path('app_users') }}" class="text-secondary text-secondary--spaced">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}