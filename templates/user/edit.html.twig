{% extends 'base.html.twig' %}

{% block title %}Modifier — DP Services{% endblock %}
{% block page_title %}Modifier {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block body %}
    <div class="welcome">
        {{ form_start(form) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
            {{ form_row(form.email) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.roles) }}
            <button type="submit" style="margin-top:1rem; padding:0.75rem 2rem; background:#2563eb; color:white; border:none; border-radius:4px; cursor:pointer;">
                Sauvegarder
            </button>
            <a href="{{ path('app_users') }}" style="margin-left:1rem; color:#64748b;">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}