{% extends 'base.html.twig' %}

{% block title %}Demandes — DP Services{% endblock %}
{% block page_title %}Gestion des demandes{% endblock %}

{% block body %}

    {# ── Filtres ── #}
    <div class="filters">
        <form method="get" class="filters__form">
            <select name="status">
                <option value="">Tous les statuts</option>
                <option value="PENDING" {{ currentStatus == 'PENDING' ? 'selected' : '' }}>⏳ En attente</option>
                <option value="VALIDATED" {{ currentStatus == 'VALIDATED' ? 'selected' : '' }}>✅ Validée</option>
                <option value="COMPLETED" {{ currentStatus == 'COMPLETED' ? 'selected' : '' }}>🏁 Terminée</option>
                <option value="CANCELLED" {{ currentStatus == 'CANCELLED' ? 'selected' : '' }}>❌ Annulée</option>
            </select>
            <input type="date" name="date" value="{{ currentDate }}">
            <button type="submit"><i class="fa-solid fa-filter"></i> Filtrer</button>
            <a href="{{ path('app_requests') }}" class="filters__reset">Réinitialiser</a>
        </form>
    </div>

    <div class="mb-md requests-actions">
        <a href="{{ path('app_request_new') }}" class="btn btn--primary btn--md">
            <i class="fa-solid fa-plus"></i> Nouvelle demande
        </a>
        <a href="{{ path('app_requests_pending') }}" class="btn btn--secondary btn--md">
            <i class="fa-solid fa-hourglass-half"></i> Modifications en attente
        </a>
    </div>

    <div class="card users-card">
        <div class="users-card__head">
            <h2>Demandes</h2>
            <span class="users-count">{{ requests|length }}</span>
        </div>
        <table class="data-table users-table">
            <thead>
                <tr>
                    <th>Logement</th>
                    <th>Prestation</th>
                    <th>Date</th>
                    <th>Heure</th>
                    <th>Femme de ménage</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for req in requests %}
                <tr>
                    <td data-label="Logement">
                        <div class="user-cell">
                            <span class="property-dot property-dot--square" style="background:{{ req.property.color }};"></span>
                            {{ req.property.name }}
                        </div>
                    </td>
                    <td data-label="Prestation">{{ req.service.name }}</td>
                    <td data-label="Date">{{ req.scheduledDate|date('d/m/Y') }}</td>
                    <td data-label="Heure">{{ req.scheduledTime|date('H:i') }}</td>
                    <td data-label="Femme de ménage">{{ req.assignedCleaner ? req.assignedCleaner.firstname ~ ' ' ~ req.assignedCleaner.lastname : '—' }}</td>
                    <td data-label="Statut">
                        {% if req.status == 'PENDING' %}
                            <span class="status-badge status-badge--sm status-badge--pending">En attente</span>
                        {% elseif req.status == 'VALIDATED' %}
                            <span class="status-badge status-badge--sm status-badge--validated">Validée</span>
                        {% elseif req.status == 'COMPLETED' %}
                            <span class="status-badge status-badge--sm status-badge--completed">Terminée</span>
                        {% elseif req.status == 'CANCELLED' %}
                            <span class="status-badge status-badge--sm status-badge--cancelled">Annulée</span>
                        {% endif %}
                    </td>
                    <td data-label="Actions">
                        <div class="row-actions">
                            <a href="{{ path('app_request_validate', {id: req.id}) }}" class="action-btn action-btn--enable" title="Valider"><i class="fa-solid fa-check"></i></a>
                            <form method="post" action="{{ path('app_request_complete', {id: req.id}) }}" class="inline-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ req.id) }}">
                                <button type="submit" class="action-btn action-btn--edit" title="Terminer"><i class="fa-solid fa-flag-checkered"></i></button>
                            </form>
                            <form method="post" action="{{ path('app_request_cancel', {id: req.id}) }}" class="inline-form" onsubmit="return confirm('Annuler ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ req.id) }}">
                                <button type="submit" class="action-btn action-btn--delete" title="Annuler"><i class="fa-solid fa-xmark"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="table-empty-cell">Aucune demande</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="u-mt-1">
        {{ knp_pagination_render(requests) }}
    </div>

{% endblock %}