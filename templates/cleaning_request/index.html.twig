{% extends 'base.html.twig' %}

{% block title %}Demandes — DP Services{% endblock %}
{% block page_title %}Gestion des demandes{% endblock %}

{% block body %}

    {# ── Filtres ── #}
    <div class="filters">
        <form method="get" class="filters__form">
            <select name="status">
                <option value="">Tous les statuts</option>
                <option value="PENDING" {{ currentStatus == 'PENDING' ? 'selected' : '' }}>⏳ En attente</option>
                <option value="VALIDATED" {{ currentStatus == 'VALIDATED' ? 'selected' : '' }}>✅ Validée</option>
                <option value="COMPLETED" {{ currentStatus == 'COMPLETED' ? 'selected' : '' }}>🏁 Terminée</option>
                <option value="CANCELLED" {{ currentStatus == 'CANCELLED' ? 'selected' : '' }}>❌ Annulée</option>
            </select>
            <input type="date" name="date" value="{{ currentDate }}">
            <button type="submit">Filtrer</button>
            <a href="{{ path('app_requests') }}" class="filters__reset">Réinitialiser</a>
        </form>
    </div>

    <div class="u-mb-1">
        <a href="{{ path('app_request_new') }}" class="btn-link">
            + Nouvelle demande
        </a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Logement</th>
                <th>Prestation</th>
                <th>Date</th>
                <th>Heure</th>
                <th>Femme de ménage</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for req in requests %}
            <tr>
                <td>
                    <span class="property-dot property-dot--square" style="background:{{ req.property.color }};"></span>
                    {{ req.property.name }}
                </td>
                <td>{{ req.service.name }}</td>
                <td>{{ req.scheduledDate|date('d/m/Y') }}</td>
                <td>{{ req.scheduledTime|date('H:i') }}</td>
                <td>{{ req.assignedCleaner ? req.assignedCleaner.firstname ~ ' ' ~ req.assignedCleaner.lastname : '—' }}</td>
                <td>
                    {% if req.status == 'PENDING' %}
                        <span class="status-badge status-badge--pending">En attente</span>
                    {% elseif req.status == 'VALIDATED' %}
                        <span class="status-badge status-badge--validated">Validée</span>
                    {% elseif req.status == 'COMPLETED' %}
                        <span class="status-badge status-badge--completed">Terminée</span>
                    {% elseif req.status == 'CANCELLED' %}
                        <span class="status-badge status-badge--cancelled">Annulée</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_request_validate', {id: req.id}) }}" class="table-action-link">Valider</a>
                    <form method="post" action="{{ path('app_request_complete', {id: req.id}) }}" class="inline-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ req.id) }}">
                        <button type="submit" class="table-action-btn table-action-btn--success">Terminer</button>
                    </form>
                    <form method="post" action="{{ path('app_request_cancel', {id: req.id}) }}" class="inline-form" onsubmit="return confirm('Annuler ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ req.id) }}">
                        <button type="submit" class="table-action-btn table-action-btn--danger">Annuler</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="table-empty-cell">Aucune demande</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="u-mt-1">
        {{ knp_pagination_render(requests) }}
    </div>

{% endblock %}
