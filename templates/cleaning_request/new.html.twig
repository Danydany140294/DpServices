{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande — DP Services{% endblock %}
{% block page_title %}Créer une demande{% endblock %}

{% block body %}

    <a href="{{ path('app_requests') }}" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour aux demandes</a>

    <div class="form-card">
        <div class="form-card__head">
            <div class="form-card__icon"><i class="fa-solid fa-clipboard-list"></i></div>
            <div>
                <h2>Nouvelle demande</h2>
                <p>Planifiez une prestation pour un logement</p>
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'form-card__body'}}) }}
            <div class="form-grid-2">
                {{ form_row(form.property) }}
                {{ form_row(form.service) }}
            </div>
            <div class="form-grid-2">
                {{ form_row(form.scheduledDate) }}
                {{ form_row(form.scheduledTime) }}
            </div>
            {{ form_row(form.assignedCleaner) }}
            {{ form_row(form.comment) }}

            <div class="form-card__actions">
                <button type="submit" class="btn btn--primary btn--lg">
                    <i class="fa-solid fa-check"></i> Créer la demande
                </button>
                <a href="{{ path('app_requests') }}" class="text-secondary text-secondary--spaced">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>

{% endblock %}