<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes missions — DP Services</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body class="has-bottom-nav">

    <header class="mobile-header">
        <div class="mobile-header__title">
            <h1>🧹 Mes missions</h1>
            <span class="user-name">{{ app.user.firstname }}</span>
        </div>

        {# -- Cloche de notifications (réutilise les mêmes fonctions Twig
              que base.html.twig : unread_notifications_count / recent_notifications) -- #}
        <div class="mobile-notif-wrapper">
            <button class="mobile-notif-btn" type="button" aria-label="Notifications" onclick="document.getElementById('mobile-notif-dropdown').classList.toggle('is-open')">
                <i class="fa-solid fa-bell"></i>
                {% set unreadCount = unread_notifications_count(app.user) %}
                {% if unreadCount > 0 %}
                    <span class="mobile-notif-badge">{{ unreadCount }}</span>
                {% endif %}
            </button>
            <div id="mobile-notif-dropdown" class="mobile-notif-dropdown">
                {% set recentNotifs = recent_notifications(app.user, 8) %}
                {% if recentNotifs is empty %}
                    <div class="mobile-notif-empty">Aucune notification</div>
                {% else %}
                    {% for notif in recentNotifs %}
                        <a href="{{ notif.link ?: '#' }}" class="mobile-notif-item {{ notif.isRead ? '' : 'mobile-notif-item--unread' }}">
                            <span class="mobile-notif-message">{{ notif.message }}</span>
                            <span class="mobile-notif-date">{{ notif.createdAt|date('d/m H:i') }}</span>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </header>

    <div class="mobile-content">

        {% if missions is empty %}
            <div class="empty-state">
                <div class="emoji">✅</div>
                <p>Aucune mission à venir</p>
            </div>
        {% else %}
            {% for mission in missions %}
                {% set isToday = mission.scheduledDate|date('Y-m-d') == today|date('Y-m-d') %}
                <div class="mission-card {{ isToday ? 'today' : '' }}">
                    <div class="mission-date">
                        {{ isToday ? '📅 Aujourd\'hui' : mission.scheduledDate|date('d/m/Y') }}
                    </div>
                    <div class="mission-property">
                        <span class="property-dot" style="background:{{ mission.property.color }};"></span>
                        {{ mission.property.name }}
                    </div>
                    <div class="mission-service">{{ mission.service.name }} — {{ mission.service.duration }} min</div>
                    <div class="mission-time">🕐 {{ mission.scheduledTime|date('H:i') }}</div>

                    {% if mission.comment %}
                        <div class="mission-comment">
                            💬 {{ mission.comment }}
                        </div>
                    {% endif %}

                    {% if mission.status == 'VALIDATED' %}
                        <form method="post" action="{{ path('app_cleaner_complete', {id: mission.id}) }}">
                            <button type="submit" class="btn-complete">✅ Marquer comme terminée</button>
                        </form>
                    {% elseif mission.status == 'COMPLETED' %}
                        <div class="mission-status-done">✅ Terminée</div>
                    {% else %}
                        <div class="mission-status-pending">⏳ En attente de validation</div>
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}

    </div>

    <nav class="bottom-nav">
        <a href="{{ path('app_cleaner') }}" class="{{ app.request.get('_route') == 'app_cleaner' ? 'active' : '' }}">
            <span class="icon">🧹</span>
            Missions
        </a>
        <a href="{{ path('app_calendar') }}" class="{{ app.request.get('_route') == 'app_calendar' ? 'active' : '' }}">
            <span class="icon">📅</span>
            Calendrier
        </a>
        <a href="{{ path('app_cleaner_history') }}" class="{{ app.request.get('_route') == 'app_cleaner_history' ? 'active' : '' }}">
            <span class="icon">✅</span>
            Historique
        </a>
    </nav>

</body>
</html>