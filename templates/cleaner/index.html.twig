{# templates/cleaner/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes missions — DP Services</title>
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body class="has-bottom-nav">


    {# ==========================================================
       HEADER — salutation + date + cloche notifications
       (logique de notif inchangée par rapport à l'existant)
       ========================================================== #}
    <header class="mobile-header">
        <div class="mobile-header__title">
            <h1>Bonjour {{ app.user.firstname }} 👋</h1>
            {# ⚠️ nécessite twig/intl-extra pour le rendu en français,
               sinon le nom du jour/mois restera en anglais #}
            <span class="user-name">{{ today|format_date('full', locale='fr') }}</span>
        </div>

        <div class="mobile-notif-wrapper">
            <button class="mobile-notif-btn" type="button" aria-label="Notifications" onclick="document.getElementById('mobile-notif-dropdown').classList.toggle('is-open')">
                <i class="ph-fill ph-bell"></i>
                {% set unreadCount = unread_notifications_count(app.user) %}
                {% if unreadCount > 0 %}
                    <span class="mobile-notif-badge">{{ unreadCount }}</span>
                {% endif %}
            </button>
            <div id="mobile-notif-dropdown" class="mobile-notif-dropdown">
                {% set recentNotifs = recent_notifications(app.user, 8) %}
                {% if recentNotifs is empty %}
                    <div class="mobile-notif-empty">Aucune notification</div>
                {% else %}
                    {% for notif in recentNotifs %}
                        <a href="{{ notif.link ?: '#' }}" class="mobile-notif-item {{ notif.isRead ? '' : 'mobile-notif-item--unread' }}">
                            <span class="mobile-notif-message">{{ notif.message }}</span>
                            <span class="mobile-notif-date">{{ notif.createdAt|date('d/m H:i') }}</span>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </header>

    <div class="mobile-content">

        {# ==========================================================
           On ne garde que les missions du jour : todayMissions sert
           à la fois au calcul de progression et à l'affichage de la liste.
           ========================================================== #}
        {% set todayMissions = missions|filter(m => m.scheduledDate|date('Y-m-d') == today|date('Y-m-d')) %}
        {% set doneToday = todayMissions|filter(m => m.status == 'COMPLETED')|length %}

        {# ==========================================================
           CARTE "Missions du jour" + barre de progression
           ========================================================== #}
        <div class="missions-count-card">
            <div class="missions-count-card__top">
                <div>
                    <div class="missions-count-card__label">Missions du jour</div>
                    <div class="missions-count-card__value">{{ todayMissionsCount }}</div>
                </div>
                <a href="{{ path('app_calendar') }}" class="missions-count-card__icon" aria-label="Voir le calendrier">
                    <i class="ph-fill ph-calendar-check"></i>
                </a>
            </div>

            {% if todayMissionsCount > 0 %}
                <div class="missions-count-card__progress">
                    <div class="missions-count-card__progress-label">
                        <span>Progression</span>
                        <span><strong>{{ doneToday }}</strong> / {{ todayMissionsCount }} terminées</span>
                    </div>
                    <div class="missions-count-card__progress-track">
                        <div class="missions-count-card__progress-fill" style="width: {{ (doneToday / todayMissionsCount * 100)|round }}%;"></div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# ==========================================================
           PROCHAINE MISSION — inchangée
           ========================================================== #}
        {% if nextMission is defined and nextMission is not null %}
            <div class="next-mission-card">
                <div class="next-mission-card__label">Prochaine mission</div>
                <div class="next-mission-card__body">
                    {% if nextMission.property.photo %}
                        <img src="{{ asset('uploads/properties/' ~ nextMission.property.photo) }}"
                             alt="{{ nextMission.property.name }}"
                             class="next-mission-card__photo">
                    {% else %}
                        <div class="next-mission-card__photo next-mission-card__photo--placeholder">
                            <i class="ph-fill ph-house"></i>
                        </div>
                    {% endif %}

                    <div class="next-mission-card__info">
                        <div class="next-mission-card__time">
                            {{ nextMission.scheduledTime|date('H:i') }} — {{ nextMission.property.name }}
                        </div>
                        <div class="next-mission-card__address">
                            <i class="ph-fill ph-map-pin"></i>
                            {{ nextMission.property.address ?: 'Adresse non renseignée' }}
                        </div>
                    </div>
                </div>

                {% if nextMission.property.address %}
                    <a href="https://www.google.com/maps/search/?api=1&query={{ nextMission.property.address|url_encode }}"
                       target="_blank" rel="noopener"
                       class="next-mission-card__cta">
                        <i class="ph-fill ph-navigation-arrow"></i> Itinéraire
                    </a>
                {% endif %}
            </div>
        {% endif %}

        {# ==========================================================
           LISTE DES MISSIONS DU JOUR — statut visuel (icône + couleur)
           et bouton "Terminer" en pilule icône + texte
           ========================================================== #}
        {% if todayMissions is empty %}
            <div class="empty-state">
                <div class="emoji">✅</div>
                <p>Aucune mission aujourd'hui</p>
            </div>
        {% else %}
            <div class="mission-list">
                {% for mission in todayMissions %}
                    <div class="mission-row" style="--mission-color: {{ mission.property.color }};">
                        <div class="mission-row__time">{{ mission.scheduledTime|date('H:i') }}</div>

                        <div class="mission-row__main">
                            <div class="mission-row__property">{{ mission.property.name }}</div>
                            <div class="mission-row__service">{{ mission.service.name }}</div>
                            {% if mission.comment %}
                                <div class="mission-row__comment">💬 {{ mission.comment }}</div>
                            {% endif %}
                        </div>

                        <div class="mission-row__side">
                            {% if mission.status == 'COMPLETED' %}
                                <span class="mission-status mission-status--done">
                                    <i class="ph-fill ph-check-circle"></i>Terminée
                                </span>
                            {% elseif mission.status == 'VALIDATED' %}
                                <span class="mission-status mission-status--upcoming">
                                    <i class="ph-fill ph-clock"></i>Aujourd'hui
                                </span>
                            {% else %}
                                <span class="mission-status mission-status--pending">
                                    <i class="ph-fill ph-hourglass-medium"></i>En attente
                                </span>
                            {% endif %}

                            {% if mission.status == 'VALIDATED' %}
                                <form method="post" action="{{ path('app_cleaner_complete', {id: mission.id}) }}" class="inline-form">
                                    <button type="submit" class="mission-row__complete-btn" aria-label="Marquer comme terminée">
                                        <i class="ph-fill ph-check-circle"></i>
                                        <span>Terminer</span>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>

    {% include 'cleaner/_bottom_nav.html.twig' %}

</body>
</html>
