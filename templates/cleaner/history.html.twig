<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historique — DP Services</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body class="has-bottom-nav">

    <header class="mobile-header">
        <h1>✅ Historique</h1>
        <span class="user-name">{{ app.user.firstname }}</span>
    </header>

    <div class="mobile-content">

        {% if missions is empty %}
            <div class="empty-state">
                <div class="emoji">📋</div>
                <p>Aucune mission terminée</p>
            </div>
        {% else %}
            {% for mission in missions %}
                <div class="mission-card mission-card--done">
                    <div class="mission-date">{{ mission.scheduledDate|date('d/m/Y') }}</div>
                    <div class="mission-property">
                        <span class="property-dot" style="background:{{ mission.property.color }};"></span>
                        {{ mission.property.name }}
                    </div>
                    <div class="mission-service">{{ mission.service.name }} — {{ mission.service.duration }} min</div>
                    <div class="mission-time">🕐 {{ mission.scheduledTime|date('H:i') }}</div>
                    <div class="mission-status-done">✅ Terminée</div>
                </div>
            {% endfor %}
        {% endif %}

    </div>

    <nav class="bottom-nav">
        <a href="{{ path('app_cleaner') }}" class="{{ app.request.get('_route') == 'app_cleaner' ? 'active' : '' }}">
            <span class="icon">🧹</span>
            Missions
        </a>
        <a href="{{ path('app_calendar') }}" class="{{ app.request.get('_route') == 'app_calendar' ? 'active' : '' }}">
            <span class="icon">📅</span>
            Calendrier
        </a>
        <a href="{{ path('app_cleaner_history') }}" class="{{ app.request.get('_route') == 'app_cleaner_history' ? 'active' : '' }}">
            <span class="icon">✅</span>
            Historique
        </a>
    </nav>

</body>
</html>
