<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historique — DP Services</title><link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body class="has-bottom-nav">

    <header class="mobile-header">
    <div class="mobile-header__title">
         <h1>Bonjour {{ app.user.firstname }} 👋</h1>
            {# ⚠️ nécessite twig/intl-extra pour le rendu en français,
               sinon le nom du jour/mois restera en anglais #}
            <span class="user-name">{{ today|format_date('full', locale='fr') }}</span>
    </div>
    </header>

    <div class="mobile-content">

        {% if missions is empty %}
            <div class="empty-state">
                <div class="emoji">📋</div>
                <p>Aucune mission terminée</p>
            </div>
        {% else %}
            {% for mission in missions %}
                <div class="mission-card mission-card--done">
                    <div class="mission-date">{{ mission.scheduledDate|date('d/m/Y') }}</div>
                    <div class="mission-property">
                        <span class="property-dot" style="background:{{ mission.property.color }};"></span>
                        {{ mission.property.name }}
                    </div>
                    <div class="mission-service">{{ mission.service.name }} — {{ mission.service.duration }} min</div>
                    <div class="mission-time">🕐 {{ mission.scheduledTime|date('H:i') }}</div>
                    <div class="mission-status-done">✅ Terminée</div>
                </div>
            {% endfor %}
        {% endif %}

    </div>

    {% include 'cleaner/_bottom_nav.html.twig' %}

</body>
</html>
