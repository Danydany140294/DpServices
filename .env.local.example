# =============================================================================
# .env.local.example — DP Services V3
# Copier ce fichier en .env.local et remplir les valeurs réelles.
# CE FICHIER EST VERSIONNÉ (pas de secrets dedans).
# .env.local lui NE DOIT PAS être commité (il est dans .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=prod
APP_SECRET=CHANGER_PAR_UNE_VRAIE_CLE_ALEATOIRE_32_CHARS

# URL de base (utilisée par le router en mode CLI/cron)
DEFAULT_URI=https://votre-domaine.com

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL sur Hetzner)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://dp_user:MOT_DE_PASSE@127.0.0.1:5432/dp_services?serverVersion=16&charset=utf8"

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# MAILER (Brevo SMTP en production)
# Remplacer null://null par les vraies credentials Brevo
# -----------------------------------------------------------------------------
MAILER_DSN=brevo+smtp://LOGIN_BREVO:CLE_BREVO@default

# -----------------------------------------------------------------------------
# BREVO SMS (API key pour les notifications SMS salariés — J40)
# Récupérer sur https://app.brevo.com → Paramètres → Clés API
# -----------------------------------------------------------------------------
BREVO_API_KEY=VOTRE_CLE_API_BREVO

# -----------------------------------------------------------------------------
# GOOGLE PLACES API (module Acquisition V2)
# Récupérer sur https://console.cloud.google.com → APIs → Places API
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=VOTRE_CLE_GOOGLE_PLACES

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR SYNC (V3 — synchronisation bidirectionnelle)
#
# ÉTAPES DE CONFIGURATION :
# 1. Créer un projet sur https://console.cloud.google.com
# 2. Activer "Google Calendar API"
# 3. Créer des identifiants OAuth 2.0 (type : Application Web)
# 4. Ajouter l'URI de redirection : https://votre-domaine.com/google/callback
# 5. Lancer : php bin/console app:google-auth
#    → Suivre les instructions pour obtenir le REFRESH_TOKEN
# 6. Coller le refresh token ci-dessous
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=VOTRE_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=https://votre-domaine.com/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REFRESH_TOKEN=VOTRE_REFRESH_TOKEN

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR WEBHOOK (TODO PROD — J33/J54)
# Activer une fois le domaine HTTPS opérationnel sur Hetzner.
# Token arbitraire (chaîne aléatoire) pour valider les webhooks entrants.
# -----------------------------------------------------------------------------
GOOGLE_WEBHOOK_CHANNEL_TOKEN=TOKEN_ALEATOIRE_POUR_VALIDER_WEBHOOKS

# -----------------------------------------------------------------------------
# MESSENGER
# -----------------------------------------------------------------------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# =============================================================================
# CRONS À CONFIGURER SUR HETZNER (J29/J54)
# Ajouter dans crontab -e :
#
# Sync Google → App toutes les 15 min :
# */15 * * * * cd /var/www/dpservices && php bin/console app:sync-google-pull >> /var/log/dp-sync.log 2>&1
#
# Relance salariés toutes les heures :
# 0 * * * * cd /var/www/dpservices && php bin/console app:notify-pending-missions >> /var/log/dp-notify.log 2>&1
#
# Purge SyncLog chaque dimanche à 2h :
# 0 2 * * 0 cd /var/www/dpservices && php bin/console app:sync-log-purge >> /var/log/dp-purge.log 2>&1
# =============================================================================